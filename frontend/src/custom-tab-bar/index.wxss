.tabbar { box-sizing:content-box; position:fixed; left:0; right:0; bottom:0; z-index:100; display:flex; height:58px; padding-bottom:env(safe-area-inset-bottom); background:#fff; border-top:1px solid #e7ede9; }
.tab-item { position:relative; flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px; color:#849188; }
.tab-item.selected { color:#147553; }
.tab-icon-wrap { position:relative; width:24px; height:24px; }
.tab-icon { width:24px; height:24px; }
.tab-label { font-size:12px; line-height:16px; font-weight:500; }
.selected .tab-label { font-weight:650; }
.publish-circle { position:absolute; top:-18px; width:70px; height:70px; box-sizing:border-box; border:4px solid #fff; border-radius:50%; background:#006633; box-shadow:0 4px 16px rgba(0,60,30,.16); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px; color:#fff; }
.publish-pressed { background:#00552b; }
.publish-label { font-size:16px; line-height:20px; font-weight:700; }
.publish-plus { position:relative; width:22px; height:22px; }
.plus-horizontal,.plus-vertical { position:absolute; background:#fff; border-radius:2px; }
.plus-horizontal { left:0; top:9.5px; width:22px; height:3px; }
.plus-vertical { top:0; left:9.5px; height:22px; width:3px; }
.unread-badge { position:absolute; top:-5px; left:17px; min-width:16px; padding:0 4px; box-sizing:border-box; border-radius:9px; background:#e45151; color:#fff; font-size:10px; line-height:16px; text-align:center; }
