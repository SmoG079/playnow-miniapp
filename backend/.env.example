# App
APP_NAME=Club MiniApp API
DEBUG=false

# Database
DATABASE_URL=mysql+asyncmy://club_user:club_pass@mysql:3306/club_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=generate-a-random-secret-key-here-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# WeChat Mini Program
WX_APP_ID=your-miniapp-appid
WX_APP_SECRET=your-miniapp-secret

# WeChat Pay V3 (商户号)
WX_MCH_ID=your-merchant-id
WX_MCH_API_V3_KEY=your-api-v3-key
WX_MCH_SERIAL_NO=your-cert-serial-no
WX_MCH_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem
WX_PAY_CERT_DIR=/app/certs
WX_PAY_NOTIFY_URL=https://www.tennisplaynow.site/api/v1/bookings/wx-notify

# OSS (Alibaba Cloud OSS or Tencent COS)
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-oss-access-key
OSS_ACCESS_KEY_SECRET=your-oss-access-secret
OSS_BUCKET_NAME=club-miniapp

# Booking
BOOKING_LOCK_TTL_SECONDS=600
FREE_CANCEL_HOURS=24
PREPAY_ID_TTL_SECONDS=300

# Settlement
SETTLEMENT_DELAY_DAYS=30
SETTLEMENT_MAX_RETRIES=3
SETTLEMENT_BATCH_SIZE=100
SETTLEMENT_PLATFORM_ACCOUNT=your-platform-mch-id-or-openid

# Refund
REFUND_MAX_RETRIES=5
REFUND_RETRY_BACKOFF_BASE_SECONDS=30
REFUND_POLL_INTERVAL_MINUTES=5
REFUND_BATCH_SIZE=50

# Rate Limiting
RATE_LIMIT_PAY_PER_MINUTE=10
RATE_LIMIT_BOOKING_PER_MINUTE=10
RATE_LIMIT_CANCEL_PER_MINUTE=10
RATE_LIMIT_REFUND_PER_MINUTE=5
