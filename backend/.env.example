# App
APP_NAME=Club MiniApp API
DEBUG=false
PUBLIC_BASE_URL=https://www.tennisplaynow.site:8443
LOG_LEVEL=INFO

# Database
DATABASE_URL=mysql+asyncmy://club_user:club_pass@mysql:3306/club_db

# Redis
REDIS_PASSWORD=redis_pass
REDIS_URL=redis://:redis_pass@redis:6379/0

# JWT
# Generate an independent random secret before starting with DEBUG=false.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# WeChat Mini Program
WX_APP_ID=your-miniapp-appid
WX_APP_SECRET=your-miniapp-secret

# WeChat Pay V3 (商户号) — 完整开通步骤见 docs/wechat-pay-setup.md
WX_MCH_ID=your-merchant-id
WX_MCH_API_V3_KEY=your-api-v3-key
WX_MCH_SERIAL_NO=your-cert-serial-no
WX_MCH_PRIVATE_KEY_PATH=/app/pay-certs/apiclient_key.pem
WX_PAY_CERT_DIR=/app/pay-certs
# 微信支付公钥（必需）：微信已下线平台证书，新商户在「商户平台 → 账户中心 →
# API安全 → 微信支付公钥」下载 pub_key.pem 并复制公钥 ID（PUB_KEY_ID_...）。
# 两者都填才会启用公钥模式；缺任一项时 SDK 会退回下载平台证书并启动失败。
WX_PAY_PUBLIC_KEY_PATH=/app/pay-certs/pub_key.pem
WX_PAY_PUBLIC_KEY_ID=PUB_KEY_ID_your-public-key-id
# 回调地址：微信要求 HTTPS、不能带 query 参数。
# 注意 443 是否可用 —— 若域名尚未完成 ICP 备案，腾讯云会拦截 80/443（webblock），
# 此时微信回调从公网进不来，订单会一直 pending。实测 8443 不被拦截，可先指过来，
# 备案完成后换回 443。无论回调是否送达，前端都会调 /bookings/{id}/sync-payment 主动查单兜底。
WX_PAY_NOTIFY_URL=https://www.tennisplaynow.site:8443/api/v1/bookings/wx-notify
# 小程序真实付款统一开关，控制订场与赛事；生产必须为 true。
# false 时赛事付费报名及新付款不可用；订场保留本地/CI 占位确认，不产生真实交易。
# 关闭新付款不会阻断已收款订单的回调、查单与退款处理。
WX_PAY_ENABLED=false
WX_PAY_DESCRIPTION=网球场地预订

# OSS (Alibaba Cloud OSS or Tencent COS)
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-oss-access-key
OSS_ACCESS_KEY_SECRET=your-oss-access-secret
# Certification PDFs/images require a separate bucket with public access disabled.
COS_PRIVATE_BUCKET_NAME=
OSS_BUCKET_NAME=club-miniapp

# Booking
BOOKING_LOCK_TTL_SECONDS=600
PREPAY_ID_TTL_SECONDS=300

# Settlement
# 平台用自有商户号直接收款时保持 false：记录仍会落库，但不向微信发起分账。
PROFIT_SHARING_ENABLED=false
SETTLEMENT_DELAY_DAYS=30
SETTLEMENT_MAX_RETRIES=3
SETTLEMENT_BATCH_SIZE=100
SETTLEMENT_PLATFORM_ACCOUNT=your-platform-mch-id-or-openid

# Refund
REFUND_MAX_RETRIES=5
REFUND_RETRY_BACKOFF_BASE_SECONDS=30
REFUND_POLL_INTERVAL_MINUTES=5
REFUND_BATCH_SIZE=50

# Tencent Location Services: enable WebService and allocate weather/reverse-geocoder quota.
# Loaded from APP_ENV_FILE (normally backend/.env), not the frontend.
TENCENT_MAP_KEY=your-tencent-map-key
# Optional SK for WebService SN signature validation; backend only.
TENCENT_MAP_SK=

# Rate Limiting
RATE_LIMIT_PAY_PER_MINUTE=10
RATE_LIMIT_BOOKING_PER_MINUTE=10
RATE_LIMIT_CANCEL_PER_MINUTE=10
RATE_LIMIT_REFUND_PER_MINUTE=5

# Tournament seat reservation lifetime
TOURNAMENT_SEAT_TTL_SECONDS=600
