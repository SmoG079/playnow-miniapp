# Copy only on the server; keep real credentials out of Git.
# Invoke with: docker compose --env-file .env.production -f compose.production.yml ...
API_IMAGE=ghcr.io/smog079/playnow-miniapp-api:<commit-sha-or-digest>
MYSQL_IMAGE=mysql@sha256:<existing-image-digest>
REDIS_IMAGE=redis@sha256:<existing-image-digest>
APP_ENV_FILE=./backend/.env
PUBLIC_BASE_URL=https://www.tennisplaynow.site:8443
LOG_LEVEL=INFO
DATABASE_URL=mysql+asyncmy://<existing-user>:<url-encoded-password>@mysql:3306/club_db
REDIS_URL=redis://:<url-encoded-password>@redis:6379/0
MYSQL_DATABASE=club_db
MYSQL_USER=<existing-user>
MYSQL_PASSWORD=<existing-password>
MYSQL_ROOT_PASSWORD=<existing-root-password>
REDIS_PASSWORD=<existing-password>
MYSQL_DATA_VOLUME=playnow-miniapp_mysql_data
REDIS_DATA_VOLUME=<existing-redis-volume-name>
APP_NETWORK=playnow-miniapp_default
