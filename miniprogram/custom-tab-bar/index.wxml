<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="index"
    class="tab-bar-item"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <block wx:if="{{index === 2}}">
      <!-- Center "+" button -->
      <view class="tab-plus-btn">
        <text class="tab-plus-icon">+</text>
      </view>
    </block>
    <block wx:else>
      <view class="tab-icon-placeholder">{{item.icon}}</view>
      <text class="tab-label" style="color: {{selected === index ? selectedColor : color}}">
        {{item.text}}
      </text>
    </block>
  </view>
</view>

<!-- Action Sheet Overlay -->
<view class="action-sheet-mask" wx:if="{{showActionSheet}}" bindtap="onMaskTap">
  <view class="action-sheet-container" catchtap="onContainerTap">
    <view class="action-sheet-title">发布</view>
    <view
      wx:for="{{actionSheetItems}}"
      wx:key="label"
      class="action-sheet-item"
      data-page="{{item.page}}"
      bindtap="onActionTap"
    >
      <text class="action-icon">{{item.icon}}</text>
      <text>{{item.label}}</text>
    </view>
    <view class="action-sheet-cancel" bindtap="closeActionSheet">取消</view>
  </view>
</view>
