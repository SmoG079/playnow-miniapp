.page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.loading-state,
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #999;
  font-size: 30rpx;
}

.message-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.message-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.message-icon {
  width: 88rpx;
  height: 88rpx;
  background-color: #e8f5e9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
}

.message-meta {
  flex: 1;
}

.message-title {
  display: block;
  font-size: 34rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.message-time {
  font-size: 26rpx;
  color: #999;
}

.message-body {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
}
