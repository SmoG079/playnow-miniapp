<view class="page">
  <view class="message-list" wx:if="{{messages.length > 0}}">
    <view
      class="message-item {{item.is_read ? '' : 'unread'}}"
      wx:for="{{messages}}"
      wx:key="id"
      data-message="{{item}}"
      bindtap="onMessageTap"
    >
      <view class="message-icon">{{item.type === 'tournament' ? '🏆' : (item.type === 'booking' ? '📋' : (item.type === 'match' ? '🏸' : '📢'))}}</view>
      <view class="message-content">
        <view class="message-header">
          <text class="message-title">{{item.title || '系统通知'}}</text>
          <text class="message-time">{{item.timeText}}</text>
        </view>
        <view class="message-preview">{{item.content}}</view>
      </view>
      <view class="unread-dot" wx:if="{{!item.is_read}}"></view>
    </view>

    <view class="load-more" wx:if="{{!hasMore}}">
      <text>没有更多了</text>
    </view>
  </view>

  <view class="empty-state" wx:if="{{messages.length === 0 && !loading}}">
    <text>暂无消息</text>
  </view>

  <view class="loading-state" wx:if="{{loading && messages.length === 0}}">
    <text>加载中...</text>
  </view>
</view>
