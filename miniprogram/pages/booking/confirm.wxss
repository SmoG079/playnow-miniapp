.page { padding: 24rpx; min-height: 100vh; background: var(--bg); }

.booking-card { margin-bottom: 24rpx; }

.card-title { font-size: 34rpx; font-weight: 600; color: var(--text); display: block; margin-bottom: 16rpx; }

.info-row { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; }
.info-label { font-size: 28rpx; color: var(--text-secondary); }
.info-value { font-size: 28rpx; color: var(--text); }
.info-divider { height: 1rpx; background: var(--border); margin: 16rpx 0; }
.price-row .info-value { font-weight: 500; }
.total-row { padding-top: 12rpx; }
.total-row .info-value { font-weight: 700; color: var(--danger); }
.text-xl { font-size: 36rpx; }

.rules-card { margin-bottom: 120rpx; }
.rules-title { font-size: 28rpx; font-weight: 600; color: var(--text); display: block; margin-bottom: 12rpx; }
.rules-item { font-size: 24rpx; color: var(--text-secondary); display: block; line-height: 1.8; }

.bottom-actions {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: 24rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg-white); box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.05);
}
.btn-pay {
  width: 100%; height: 88rpx; line-height: 88rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff; font-size: 32rpx; font-weight: 600;
  border-radius: 44rpx; border: none; text-align: center;
}
.btn-pay[disabled] { opacity: 0.6; }
.cancel-link { display: block; text-align: center; font-size: 26rpx; color: var(--text-secondary); margin-top: 20rpx; }
