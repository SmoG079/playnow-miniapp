.page { padding-bottom: 160rpx; background: #f5f5f5; min-height: 100vh; }

/* Float Header */
.float-header {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: #fff; display: flex; align-items: center;
  justify-content: space-between; padding: 0 24rpx 12rpx;
  box-shadow: 0 1rpx 6rpx rgba(0,0,0,0.06);
}
.back-btn { font-size: 30rpx; color: #07c160; }
.header-title { font-size: 32rpx; font-weight: 600; color: #333; }

/* Club Info Card */
.club-card { background: #fff; margin-bottom: 12rpx; }
.club-swiper { width: 100%; height: 360rpx; }
.swiper-img { width: 100%; height: 100%; }
.club-body { padding: 20rpx 24rpx; }
.club-name { font-size: 36rpx; font-weight: 700; display: block; margin-bottom: 8rpx; }
.club-meta { font-size: 26rpx; color: #666; display: block; line-height: 1.6; }

.club-desc { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f0f0; }
.desc-label { font-size: 26rpx; color: #07c160; font-weight: 500; }
.desc-text { font-size: 26rpx; color: #666; line-height: 1.6; display: block; margin-top: 8rpx; }

/* Date Tabs */
.date-scroll { white-space: nowrap; padding: 12rpx 24rpx; }
.date-tab {
  display: inline-flex; align-items: center; justify-content: center;
  width: 120rpx; height: 56rpx; margin-right: 12rpx; border-radius: 28rpx;
  background: #fff; color: #666; font-size: 26rpx;
}
.date-tab.active { background: #07c160; color: #fff; }

/* Grid */
.grid-table { margin: 12rpx 16rpx; background: #fff; border-radius: 12rpx; overflow: hidden; }
.grid-header { display: flex; background: #f8f8f8; border-bottom: 1rpx solid #eee; }
.venue-col-hd { flex: 1; text-align: center; padding: 14rpx 0; font-size: 26rpx; color: #333; font-weight: 500; }

.grid-row { display: flex; border-bottom: 1rpx solid #f5f5f5; }

.grid-cell {
  flex: 1; min-height: 64rpx; display: flex; flex-direction: column;
  align-items: center; justify-content: center; padding: 4rpx 2rpx;
  border-left: 1rpx solid #f0f0f0;
}
.grid-cell.available { background: #e8f5e9; }
.grid-cell.booked { background: #eee; }
.grid-cell.locked { background: #f5f5f5; }
.grid-cell.past { background: #fafafa; opacity: 0.5; }
.grid-cell.none { background: #fafafa; }
.grid-cell.selected { background: #fff3cd; }

.cell-time { font-size: 20rpx; color: #333; }
.cell-price { font-size: 18rpx; color: #e74c3c; }
.grid-cell.selected .cell-price { color: #8b6914; }
.grid-cell.selected .cell-time { font-weight: 700; color: #8b6914; }
.cell-tag { font-size: 18rpx; color: #999; }
.cell-tick { color: #f0a020; font-size: 24rpx; font-weight: 700; }

.empty-state { text-align: center; padding: 80rpx 0; color: #999; }

/* Bottom Bar */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: 20rpx 24rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.08);
  display: flex; align-items: center; gap: 20rpx;
}
.price-info { flex: 1; }
.price-label { font-size: 26rpx; color: #666; display: block; }
.price-value { font-size: 36rpx; font-weight: 700; color: #e74c3c; }
.btn-book {
  height: 80rpx; padding: 0 40rpx; font-size: 30rpx; font-weight: 600;
  background: #07c160; color: #fff; border-radius: 40rpx; border: none; line-height: 80rpx;
}
