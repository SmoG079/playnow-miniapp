.page { padding-bottom: 40rpx; }

.club-header { position: relative; }
.club-cover { width: 100%; height: 360rpx; }
.club-header-info { padding: 24rpx; background: var(--bg-white); }
.club-name { font-size: 36rpx; font-weight: 700; color: var(--text); display: block; margin-bottom: 8rpx; }
.club-tags { display: flex; gap: 12rpx; margin-top: 12rpx; flex-wrap: wrap; }

.club-desc { margin: 20rpx; }
.desc-text { font-size: 28rpx; color: var(--text); line-height: 1.6; }

.venues-section { margin: 20rpx 0; }
.section-header { padding: 0 20rpx; margin-bottom: 16rpx; }
.section-title { font-size: 32rpx; font-weight: 600; color: var(--text); }

.venue-card { display: flex; margin: 0 20rpx 16rpx 20rpx; }
.venue-cover { width: 160rpx; height: 160rpx; border-radius: 12rpx; flex-shrink: 0; }
.venue-info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; }
.venue-name { font-size: 30rpx; font-weight: 600; color: var(--text); margin-bottom: 4rpx; }
.venue-status { font-size: 24rpx; padding: 4rpx 12rpx; border-radius: 6rpx; }
.venue-status.active { background: #e8f8ee; color: var(--primary); }
.venue-status.maintenance { background: #fff8e0; color: #d4a000; }
.venue-status.closed { background: #f0f0f0; color: var(--text-secondary); }

.admin-section { padding: 0 20rpx; margin-top: 20rpx; }

.empty-state { text-align: center; padding: 100rpx 0; color: var(--text-secondary); }
