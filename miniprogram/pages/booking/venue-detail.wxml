<view class="page" style="padding-top:{{statusBarH + 44}}px">
  <!-- Floating Header -->
  <view class="float-header" style="padding-top:{{statusBarH}}px">
    <view class="back-btn" bindtap="onBack">‹ 返回</view>
    <text class="header-title">选择时段</text>
    <view style="width:80rpx"></view>
  </view>

  <!-- Club Info Card -->
  <view class="club-card" wx:if="{{club}}">
    <!-- Image Carousel -->
    <swiper class="club-swiper" indicator-dots="{{club.images.length > 1}}" autoplay circular>
      <swiper-item wx:for="{{club.images.length ? club.images : [club.cover_image || '/images/default-venue.png']}}" wx:key="*this">
        <image class="swiper-img" src="{{item}}" mode="aspectFill" />
      </swiper-item>
    </swiper>
    <view class="club-body">
      <text class="club-name">{{club.name}}</text>
      <text class="club-meta" wx:if="{{club.address}}">📍 {{club.address}}</text>
      <text class="club-meta">🕐 {{club.opening_time || '08:00'}} - {{club.closing_time || '22:00'}}</text>
      <text class="club-meta" wx:if="{{club.contact_phone}}">📞 {{club.contact_phone}}</text>
      <view class="club-desc" wx:if="{{club.description}}" bindtap="onToggleDesc">
        <text class="desc-label">📖 俱乐部介绍 {{showDesc ? '▲' : '▼'}}</text>
        <text class="desc-text" wx:if="{{showDesc}}">{{club.description}}</text>
      </view>
      <view class="club-desc" wx:if="{{club.rules}}" bindtap="onToggleRules">
        <text class="desc-label">📋 场地规则 {{showRules ? '▲' : '▼'}}</text>
        <text class="desc-text" wx:if="{{showRules}}">{{club.rules}}</text>
      </view>
    </view>
  </view>

  <!-- Date Tabs -->
  <scroll-view class="date-scroll" scroll-x>
    <view wx:for="{{dateOptions}}" wx:key="value"
      class="date-tab {{selectedDate === item.value ? 'active' : ''}}"
      data-date="{{item.value}}" bindtap="onDateChange">{{item.label}}</view>
  </scroll-view>

  <!-- Slot Grid: columns = venues, rows = time -->
  <view class="grid-table">
    <view class="grid-header">
      <view class="venue-col-hd" wx:for="{{venues}}" wx:key="id">{{item.name}}</view>
    </view>
    <view wx:for="{{grid}}" wx:for-item="row" wx:key="time_label" class="grid-row">
      <view wx:for="{{row.cells}}" wx:for-item="cell" wx:for-index="ci" wx:key="venue_id"
        class="grid-cell {{cell.status}} {{cell._sel ? 'selected' : ''}}"
        data-row-idx="{{index}}" data-col-idx="{{ci}}" bindtap="onSlotTap">
        <text class="cell-time">{{row.time_label}}</text>
        <text class="cell-price" wx:if="{{cell.status === 'available' || cell._sel}}">¥{{cell.price}}</text>
        <text wx:if="{{cell.status === 'booked'}}" class="cell-tag">已约</text>
        <text wx:elif="{{cell.status === 'locked'}}" class="cell-tag">锁定</text>
        <text wx:elif="{{cell._sel}}" class="cell-tick">✓</text>
      </view>
    </view>
    <view wx:if="{{grid.length === 0 && !loading}}" class="empty-state"><text>暂无可用时段</text></view>
  </view>

  <!-- Bottom Bar -->
  <view class="bottom-bar" wx:if="{{selectedSlots.length > 0}}">
    <view class="price-info">
      <text class="price-label">{{selectedInfo.date}} · {{selectedInfo.start}}-{{selectedInfo.end}}</text>
      <text class="price-value">¥{{totalPrice}}</text>
    </view>
    <button class="btn-book" bindtap="onBook" disabled="{{!selectedInfo}}">立即预约</button>
  </view>
</view>
