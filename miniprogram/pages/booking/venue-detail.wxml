<view class="page">
  <!-- Venue Info -->
  <view class="venue-header" wx:if="{{venue}}">
    <image class="venue-cover" src="{{venue.cover_image || '/images/default-venue.png'}}" mode="aspectFill" />
    <view class="venue-info">
      <text class="venue-name">{{venue.name}}</text>
      <text class="text-secondary">网球 · ¥{{venue.price_per_hour}}/小时</text>
      <text class="text-secondary">营业时间 {{venue.open_time || '08:00'}} - {{venue.close_time || '22:00'}}</text>
    </view>
  </view>

  <!-- Date Selector -->
  <scroll-view class="date-scroll" scroll-x>
    <view
      wx:for="{{dateOptions}}" wx:key="value"
      class="date-item {{selectedDate === item.value ? 'active' : ''}}"
      data-date="{{item.value}}" bindtap="onDateChange"
    >
      <text class="date-weekday">{{item.weekday}}</text>
      <text class="date-label">{{item.label}}</text>
    </view>
  </scroll-view>

  <!-- Time Slots (30-min grid) -->
  <view class="slot-section">
    <block wx:for="{{slotGroups}}" wx:key="date">
      <view class="slot-date-group">
        <text class="slot-date-title">{{item.date}}</text>
        <text class="text-sm text-secondary">点击连续两格选 1 小时</text>
        <view class="slot-grid">
          <view
            wx:for="{{item.slots}}" wx:for-item="slot" wx:key="id"
            class="slot-item {{slot.status}} {{slot._sel ? 'selected' : ''}}"
            data-slot="{{slot}}" bindtap="onSlotTap"
          >
            <view class="slot-left">
              <text class="slot-time">{{slot.start_time}} - {{slot.end_time}}</text>
            </view>
            <text class="slot-price">¥{{slot.price}}</text>
            <text class="slot-tag" wx:if="{{slot.status === 'booked'}}">已约</text>
            <text class="slot-tag" wx:elif="{{slot.status === 'locked'}}">锁定</text>
            <text class="slot-tick" wx:elif="{{slot._sel}}">✓ 已选</text>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{slotGroups.length === 0 && !loading}}" class="empty-state">
      <text>暂无可用时间段</text>
    </view>
  </view>

  <!-- Selected Info + Confirm Button -->
  <view class="bottom-bar" wx:if="{{selectedInfo}}">
    <view class="selected-info">
      <text class="selected-label">{{selectedInfo.date}} · {{selectedInfo.startTime}}-{{selectedInfo.endTime}}（1小时）</text>
      <text class="selected-price">¥{{selectedInfo.price}}</text>
    </view>
    <button class="btn-pay" bindtap="onConfirmBooking">立即预约</button>
  </view>
</view>
