.page { padding-bottom: env(safe-area-inset-bottom); }

.search-bar { display: flex; align-items: center; margin: 20rpx; padding: 12rpx 20rpx; background: #fff; border-radius: 40rpx; }
.search-input { flex: 1; font-size: 28rpx; }
.search-btn { color: var(--primary); font-size: 28rpx; padding-left: 20rpx; }

.filter-scroll { white-space: nowrap; padding: 0 20rpx 20rpx; }
.filter-item { display: inline-block; padding: 10rpx 28rpx; margin-right: 16rpx; border-radius: 30rpx; background: #fff; font-size: 26rpx; }
.filter-item.active { background: var(--primary); color: #fff; }

.club-card { display: flex; align-items: center; gap: 20rpx; margin-bottom: 16rpx; }
.club-cover { width: 120rpx; height: 120rpx; border-radius: 12rpx; flex-shrink: 0; background: #eee; }
.club-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.club-name { font-size: 30rpx; font-weight: 600; }
.club-tags { display: flex; gap: 8rpx; flex-wrap: wrap; }
.club-arrow { font-size: 36rpx; color: #ccc; }

.empty-state { text-align: center; padding: 120rpx 0; color: var(--text-light); }
