<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索俱乐部..." value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearch" />
    <text class="search-btn" bindtap="onSearch">搜索</text>
  </view>

  <scroll-view class="filter-scroll" scroll-x>
    <view
      wx:for="{{['全部','羽毛球','篮球','网球','乒乓球','足球']}}"
      wx:key="*this"
      class="filter-item {{sportFilter === item ? 'active' : ''}}"
      data-value="{{item === '全部' ? '' : item}}"
      bindtap="onSportFilter"
    >{{item}}</view>
  </scroll-view>

  <block wx:for="{{clubs}}" wx:key="id">
    <view class="club-card card" data-id="{{item.id}}" bindtap="onClubDetail">
      <image class="club-cover" src="{{item.cover_image || '/images/default-venue.png'}}" mode="aspectFill" />
      <view class="club-info">
        <text class="club-name">{{item.name}}</text>
        <text class="text-sm text-secondary">{{item.address || '暂无地址'}}</text>
        <view class="club-tags">
          <text class="tag tag-primary" wx:for="{{item.sport_types}}" wx:for-item="sport" wx:key="*this">{{sport}}</text>
        </view>
      </view>
      <text class="club-arrow">›</text>
    </view>
  </block>

  <view wx:if="{{clubs.length === 0 && !loading}}" class="empty-state">
    <text>暂未找到俱乐部</text>
    <button class="btn-primary" style="margin-top:20rpx" bindtap="onCreateClub">创建俱乐部</button>
  </view>
</view>
