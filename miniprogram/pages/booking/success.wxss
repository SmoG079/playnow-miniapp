.page {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; min-height: 100vh; background: var(--bg);
  padding: 48rpx;
}

.success-card {
  text-align: center; background: var(--bg-white);
  border-radius: 24rpx; padding: 60rpx 48rpx;
  box-shadow: var(--shadow); width: 100%; margin-bottom: 48rpx;
}

.success-icon {
  display: inline-flex; align-items: center; justify-content: center;
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: var(--primary); color: #fff; font-size: 64rpx;
  margin-bottom: 24rpx;
}

.success-title {
  font-size: 38rpx; font-weight: 700; color: var(--text);
  display: block; margin-bottom: 12rpx;
}

.success-desc {
  font-size: 28rpx; color: var(--text-secondary);
  display: block; margin-bottom: 16rpx;
}

.order-no {
  font-size: 24rpx; color: var(--text-light); font-family: monospace;
  display: block; margin-top: 8rpx;
}

.actions { width: 100%; text-align: center; }

.actions .btn-primary {
  width: 100%; height: 88rpx; line-height: 88rpx;
  font-size: 32rpx; border-radius: 44rpx;
  margin-bottom: 24rpx;
}

.home-link {
  font-size: 28rpx; color: var(--text-secondary);
}
