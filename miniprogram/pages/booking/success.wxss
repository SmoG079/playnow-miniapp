.page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 40rpx 20rpx;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

.success-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 60rpx;
}

.icon-success {
  width: 120rpx;
  height: 120rpx;
  background-color: #07c160;
  border-radius: 50%;
  position: relative;
  margin-bottom: 24rpx;
}

.icon-success::after {
  content: '';
  position: absolute;
  left: 36rpx;
  top: 52rpx;
  width: 28rpx;
  height: 12rpx;
  border-left: 6rpx solid #fff;
  border-bottom: 6rpx solid #fff;
  transform: rotate(-45deg);
}

.icon-loading {
  width: 120rpx;
  height: 120rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #07c160;
  border-radius: 50%;
  position: relative;
  margin-bottom: 24rpx;
  animation: spin 1s linear infinite;
}

.icon-info {
  width: 120rpx;
  height: 120rpx;
  background-color: #ff9500;
  border-radius: 50%;
  position: relative;
  margin-bottom: 24rpx;
}

.icon-info::after {
  content: '';
  position: absolute;
  left: 52rpx;
  top: 28rpx;
  width: 6rpx;
  height: 44rpx;
  background-color: #fff;
  border-radius: 2rpx;
}

.icon-info::before {
  content: '';
  position: absolute;
  left: 52rpx;
  top: 82rpx;
  width: 6rpx;
  height: 6rpx;
  background-color: #fff;
  border-radius: 50%;
}

.icon-warning {
  width: 120rpx;
  height: 120rpx;
  background-color: #ff9500;
  border-radius: 50%;
  position: relative;
  margin-bottom: 24rpx;
}

.icon-warning::after {
  content: '';
  position: absolute;
  left: 52rpx;
  top: 28rpx;
  width: 6rpx;
  height: 44rpx;
  background-color: #fff;
  border-radius: 2rpx;
}

.icon-warning::before {
  content: '';
  position: absolute;
  left: 52rpx;
  top: 82rpx;
  width: 6rpx;
  height: 6rpx;
  background-color: #fff;
  border-radius: 50%;
}

.icon-error {
  width: 120rpx;
  height: 120rpx;
  background-color: #f44336;
  border-radius: 50%;
  position: relative;
  margin-bottom: 24rpx;
}

.icon-error::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 48rpx;
  height: 6rpx;
  background-color: #fff;
  border-radius: 2rpx;
  transform: translate(-50%, -50%) rotate(45deg);
}

.icon-error::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 48rpx;
  height: 6rpx;
  background-color: #fff;
  border-radius: 2rpx;
  transform: translate(-50%, -50%) rotate(-45deg);
}

.success-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.success-subtitle {
  font-size: 26rpx;
  color: #999;
}

.order-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.info-value.price {
  color: #ff6b6b;
  font-weight: bold;
}

.info-value.status-paid {
  color: #07c160;
}

.info-value.status-pending {
  color: #ff9500;
}

.info-value.status-refunding {
  color: #f44336;
}

.info-value.status-refunded,
.info-value.status-cancelled {
  color: #999;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0 20rpx;
}

.btn-primary {
  height: 88rpx;
  line-height: 88rpx;
  background-color: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  height: 88rpx;
  line-height: 88rpx;
  background-color: #fff;
  color: #07c160;
  font-size: 30rpx;
  border: 2rpx solid #07c160;
  border-radius: 44rpx;
}

.btn-outline::after {
  border: none;
}
