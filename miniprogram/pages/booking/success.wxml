<view class="page">
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="error-state" wx:if="{{!loading && error}}">
    <text class="error-text">加载订单失败</text>
    <button class="btn-outline" bindtap="loadBooking">重试</button>
  </view>

  <block wx:if="{{!loading && !error && booking}}">
    <view class="success-header">
      <view class="{{getStatusMeta(booking.status, polling).icon}}"></view>
      <text class="success-title">{{getStatusMeta(booking.status, polling).title}}</text>
      <text class="success-subtitle" wx:if="{{getStatusMeta(booking.status, polling).subtitle}}">{{getStatusMeta(booking.status, polling).subtitle}}</text>
    </view>

    <view class="order-card">
      <view class="info-row">
        <text class="info-label">订单编号</text>
        <text class="info-value">{{booking.order_no}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">俱乐部</text>
        <text class="info-value">{{booking.club_name || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">场地</text>
        <text class="info-value">{{booking.venue_name || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">预约时间</text>
        <text class="info-value">{{booking.slot_date}} {{booking.slot_start}} ~ {{booking.slot_end}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">支付金额</text>
        <text class="info-value price">¥{{booking.amount}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">支付状态</text>
        <text class="info-value status-{{booking.status}}">{{formatStatus(booking.status)}}</text>
      </view>
    </view>

    <view class="action-section">
      <button class="btn-primary" bindtap="onViewBookings">查看我的预约</button>
      <button class="btn-outline" bindtap="onGoHome">返回首页</button>
    </view>
  </block>
</view>
