.page { padding-bottom: env(safe-area-inset-bottom); }

.search-bar {
  display: flex; align-items: center;
  margin: 20rpx; padding: 16rpx 24rpx;
  background: #fff; border-radius: 40rpx;
  box-shadow: var(--shadow);
}
.search-icon { margin-right: 12rpx; }
.search-placeholder { color: var(--text-light); }

.sort-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20rpx 16rpx;
}
.sort-options {
  display: flex;
  gap: 16rpx;
}
.sort-item {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  background: #fff;
  color: var(--text-secondary);
}
.sort-item.active {
  background: var(--primary);
  color: #fff;
}
.location-hint {
  font-size: 24rpx;
  color: #ff9500;
}

.filter-scroll { white-space: nowrap; padding: 0 20rpx 20rpx; }
.filter-item {
  display: inline-block; padding: 10rpx 28rpx;
  margin-right: 16rpx; border-radius: 30rpx;
  background: #fff; font-size: 26rpx;
}
.filter-item.active { background: var(--primary); color: #fff; }

.section { margin-bottom: 20rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 20rpx 0; }
.section-title { font-size: 30rpx; font-weight: 600; }
.section-more { color: var(--text-secondary); font-size: 24rpx; }

.tour-scroll { white-space: nowrap; padding: 16rpx 20rpx; }
.tournament-card-h {
  display: inline-block; width: 320rpx; margin-right: 20rpx;
  background: #fff; border-radius: var(--radius); overflow: hidden;
  box-shadow: var(--shadow);
}
.tour-cover { width: 100%; height: 160rpx; }
.tour-info { padding: 16rpx; display: flex; flex-direction: column; gap: 4rpx; }
.tour-title { font-size: 28rpx; font-weight: 500; }

.post-card { margin-bottom: 16rpx; }
.post-header { display: flex; align-items: center; gap: 16rpx; }
.avatar { width: 64rpx; height: 64rpx; border-radius: 50%; }
.post-user-info { flex: 1; display: flex; flex-direction: column; }
.post-username { font-size: 28rpx; font-weight: 500; }
.post-body { margin-top: 16rpx; }
.post-title { font-size: 30rpx; font-weight: 500; }
.post-meta { margin-top: 12rpx; display: flex; gap: 20rpx; font-size: 24rpx; color: var(--text-secondary); }
.distance-text { color: #ff9500; font-weight: 500; }
.post-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; }
.post-actions { display: flex; gap: 20rpx; align-items: center; }
.share-btn-mini {
  font-size: 22rpx; padding: 4rpx 16rpx; background: none; border: 1rpx solid var(--primary);
  color: var(--primary); border-radius: 20rpx; line-height: 1.4;
}
.share-btn-mini::after { border: none; }

.empty-state { text-align: center; padding: 80rpx 0; color: var(--text-light); }
