.page { padding-bottom: env(safe-area-inset-bottom); background: #f5f5f5; }

/* Header Bar */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(180deg, #e8f5e9 0%, #f5f5f5 100%);
}
.location-selector {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.location-icon { font-size: 28rpx; }
.location-text { font-size: 30rpx; font-weight: 600; color: #333; }
.location-arrow { font-size: 20rpx; color: #999; margin-left: 4rpx; }
.header-actions {
  display: flex;
  gap: 24rpx;
}
.header-btn { font-size: 32rpx; color: #666; }

/* Sport Tabs */
.sport-tabs {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx 20rpx;
  background: linear-gradient(180deg, #e8f5e9 0%, #f5f5f5 100%);
}
.sport-tab {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: #fff;
  color: #666;
  font-size: 28rpx;
}
.sport-tab.active {
  background: #5CD29D;
  color: #fff;
}
.sport-tab.disabled {
  opacity: 0.5;
}
.sport-tab-icon { font-size: 32rpx; }

/* Filter Bar */
.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 0 30rpx 20rpx;
}
.filter-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  background: #fff;
  color: #666;
  font-size: 26rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.filter-arrow { font-size: 20rpx; color: #999; }

/* Card List */
.card-list { padding: 0 20rpx; }

/* Match Card */
.match-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

/* Organizer */
.match-organizer {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.organizer-logo {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f0f0f0;
}
.organizer-name {
  font-size: 24rpx;
  color: #999;
}

/* Title Row */
.match-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.match-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}
.verify-badge {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #4CAF50;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Main Content: Image + Info */
.match-content {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.match-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}
.match-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
}
.info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.info-icon {
  font-size: 28rpx;
  width: 32rpx;
  text-align: center;
}
.info-text {
  font-size: 26rpx;
  color: #666;
  flex: 1;
}
.info-text.distance {
  color: #ff9500;
  font-weight: 500;
}

/* Footer: Registrations + Button */
.match-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.registration-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.avatar-stack {
  display: flex;
}
.stack-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
  margin-left: -16rpx;
}
.stack-avatar:first-child {
  margin-left: 0;
}
.registration-text {
  font-size: 24rpx;
  color: #999;
}
.action-btn {
  padding: 12rpx 32rpx;
  border-radius: 28rpx;
  background: #5CD29D;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}
.action-btn.full {
  background: #e0e0e0;
  color: #999;
}
.action-btn.registered {
  background: #e3f2fd;
  color: #1976d2;
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}
