.page { background: #f5f5f5; min-height: 100vh; }

/* Top Tabs */
.top-tabs { display: flex; background: #fff; }
.top-tab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 30rpx; color: #666; position: relative; }
.top-tab.active { color: #07c160; font-weight: 600; }
.top-tab.active::after {
  content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
  width: 48rpx; height: 4rpx; background: #07c160; border-radius: 2rpx;
}

/* Filter Bar */
.filter-bar { display: flex; align-items: center; padding: 12rpx 16rpx; background: #fff; border-bottom: 1rpx solid #eee; gap: 8rpx; flex-wrap: wrap; }
.f-tab { padding: 8rpx 16rpx; border-radius: 16rpx; font-size: 24rpx; background: #f5f5f5; color: #666; }
.f-tab.active { background: #07c160; color: #fff; }
.f-spacer { flex: 1; }
.f-date { padding: 8rpx 16rpx; border-radius: 16rpx; font-size: 24rpx; background: #f5f5f5; color: #666; }
.f-date.active { background: #e8f5e9; color: #07c160; }
.f-clear { font-size: 24rpx; color: #999; padding: 0 4rpx; }
.f-dist { padding: 8rpx 12rpx; border-radius: 16rpx; font-size: 24rpx; background: #f5f5f5; color: #666; }
.f-dist.active { background: #e3f2fd; color: #1565c0; }
.ntrp-row { white-space: nowrap; padding: 8rpx 16rpx; background: #fff; border-bottom: 1rpx solid #eee; }
.ntrp-item { display: inline-block; padding: 6rpx 14rpx; margin-right: 8rpx; border-radius: 12rpx; font-size: 22rpx; background: #f5f5f5; color: #999; }
.ntrp-item.active { background: #07c160; color: #fff; }

/* Post Card */
.post-card { background: #fff; margin: 12rpx 16rpx; border-radius: 12rpx; padding: 20rpx; }
.post-header { display: flex; align-items: center; margin-bottom: 12rpx; }
.avatar { width: 56rpx; height: 56rpx; border-radius: 50%; margin-right: 12rpx; }
.post-user { flex: 1; }
.username { font-size: 28rpx; font-weight: 500; display: block; }
.time { font-size: 22rpx; color: #999; }
.post-title { font-size: 30rpx; font-weight: 600; display: block; margin-bottom: 10rpx; }
.post-meta { display: flex; flex-wrap: wrap; gap: 12rpx; font-size: 24rpx; color: #999; }
.tour-cover { width: 100%; height: 260rpx; border-radius: 8rpx; margin-bottom: 10rpx; }
.tag { padding: 4rpx 10rpx; border-radius: 6rpx; font-size: 22rpx; }
.tag-primary { background: #e8f8ee; color: #07c160; }
.tag-warning { background: #fff8e0; color: #d4a000; }
.empty-state { text-align: center; padding: 80rpx 0; color: #999; }
