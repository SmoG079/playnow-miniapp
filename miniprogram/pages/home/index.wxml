<view class="page">
  <!-- Top Tabs -->
  <view class="top-tabs">
    <view class="top-tab {{activeTab === 0 ? 'active' : ''}}" data-tab="0" bindtap="onTabChange">约球广场</view>
    <view class="top-tab {{activeTab === 1 ? 'active' : ''}}" data-tab="1" bindtap="onTabChange">比赛</view>
  </view>

  <!-- 约球广场 -->
  <block wx:if="{{activeTab === 0}}">
    <!-- Filter bar -->
    <view class="filter-bar">
      <view class="f-tab {{matchFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="onMatchFilter">全部</view>
      <view class="f-tab {{matchFilter === 'free' ? 'active' : ''}}" data-filter="free" bindtap="onMatchFilter">🏸 自由</view>
      <view class="f-tab {{matchFilter === 'venue' ? 'active' : ''}}" data-filter="venue" bindtap="onMatchFilter">🏟️ 订场</view>
      <view class="f-spacer"></view>
      <picker mode="date" value="{{filterDate}}" bindchange="onDateChange">
        <view class="f-date {{filterDate ? 'active' : ''}}">{{filterDate || '📅 日期'}}</view>
      </picker>
      <text wx:if="{{filterDate}}" class="f-clear" bindtap="onClearDate">✕</text>
      <text class="f-dist {{sortByDist ? 'active' : ''}}" bindtap="onToggleDist">{{sortByDist ? '📍 距离排序' : '📌 按距离'}}</text>
    </view>
    <!-- NTRP row -->
    <scroll-view class="ntrp-row" scroll-x>
      <text wx:for="{{NTRP_OPTIONS}}" wx:key="*this"
        class="ntrp-item {{filterNtrp === item ? 'active' : ''}}"
        data-val="{{item === '不限' ? '' : item}}" bindtap="onNtrpChange">{{item}}</text>
    </scroll-view>

    <view wx:for="{{displayPosts}}" wx:key="id" class="post-card" data-id="{{item.id}}" bindtap="onPostDetail">
      <view class="post-header">
        <image class="avatar" src="{{item.user_avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
        <view class="post-user">
          <text class="username">{{item.user_nickname || '匿名'}}</text>
          <text class="time">{{item.created_at}}</text>
        </view>
        <view class="post-mode tag {{item.venue_id ? 'tag-warning' : 'tag-primary'}}">
          {{item.venue_id ? '定场' : '自由'}}
        </view>
      </view>
      <text class="post-title">{{item.title}}</text>
      <view class="post-meta">
        <text wx:if="{{item.preferred_date}}">📅 {{item.preferred_date}}</text>
        <text wx:if="{{item.level_required}}">🎯 {{item.level_required}}</text>
        <text>👥 {{item.registration_count}}人报名</text>
        <text wx:if="{{item.club_name}}">{{item.club_name}}</text>
      </view>
    </view>
    <view wx:if="{{displayPosts.length === 0}}" class="empty-state"><text>暂无约球帖</text></view>
  </block>

  <!-- 比赛 -->
  <block wx:if="{{activeTab === 1}}">
    <view wx:for="{{tournaments}}" wx:key="id" class="post-card" data-id="{{item.id}}" bindtap="onTourDetail">
      <image class="tour-cover" src="{{item.cover_image || '/images/default-match.png'}}" mode="aspectFill" />
      <view class="post-body">
        <text class="post-title">{{item.title}}</text>
        <view class="post-meta">
          <text>{{item.club_name}}</text>
          <text>{{item.start_time}}</text>
          <text>👥 {{item.current_participants}}/{{item.max_participants}}人</text>
        </view>
      </view>
    </view>
    <view wx:if="{{tournaments.length === 0}}" class="empty-state"><text>暂无比赛</text></view>
  </block>
</view>
