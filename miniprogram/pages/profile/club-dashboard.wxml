<view class="page">
  <!-- Club Selector (when managing multiple clubs) -->
  <view class="club-picker" wx:if="{{managedClubs.length > 1}}">
    <picker bindchange="onClubChange" value="{{clubIndex}}" range="{{managedClubs}}" range-key="name">
      <view class="picker-value">
        <text>🏠 {{managedClubs[clubIndex].name}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- Club Info Card -->
  <view class="club-card" wx:if="{{club}}">
    <view class="club-cover-wrap">
      <swiper class="club-swiper" indicator-dots="{{imgList.length > 1}}" autoplay circular>
        <swiper-item wx:for="{{imgList}}" wx:key="*this">
          <image class="club-cover" src="{{item}}" mode="aspectFill" />
        </swiper-item>
      </swiper>
      <view class="club-name-overlay">
        <text class="club-name">{{club.name}}</text>
        <text class="club-status {{club.status === 'active' ? 'active' : 'inactive'}}">
          {{club.status === 'active' ? '营业中' : '休息中'}}
        </text>
      </view>
    </view>
    <view class="club-info">
      <view class="info-row" wx:if="{{club.address}}">
        <text class="info-icon">📍</text>
        <text class="info-text">{{club.address}}</text>
      </view>
      <view class="info-row" wx:if="{{club.contact_phone}}" bindtap="onPhoneTap">
        <text class="info-icon">📞</text>
        <text class="info-text link">{{club.contact_phone}}</text>
      </view>
    </view>
  </view>

  <!-- Stats Row -->
  <view class="stats-row" wx:if="{{stats}}">
    <view class="stat-item">
      <text class="stat-num">{{stats.total_venues}}</text>
      <text class="stat-label">场地数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.today_orders}}</text>
      <text class="stat-label">今日订单</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">¥{{stats.today_revenue}}</text>
      <text class="stat-label">今日收入</text>
    </view>
  </view>

  <!-- Exposure Stats -->
  <view class="stats-row exposure-row" wx:if="{{stats}}">
    <view class="stat-item">
      <text class="stat-num">{{stats.view_count}}</text>
      <text class="stat-label">浏览量</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.exposure_count}}</text>
      <text class="stat-label">曝光量</text>
    </view>
  </view>

  <!-- Venue List -->
  <view class="section" wx:if="{{club}}">
    <view class="section-hd">
      <text class="section-title">🏟️ 场地管理 ({{venues.length}}个)</text>
      <text class="add-link" bindtap="onAddVenue">+ 添加场地</text>
    </view>
    <view wx:for="{{venues}}" wx:key="id" class="venue-row">
      <view class="venue-info">
        <text class="vname">{{item.name}}</text>
        <text class="vmeta">¥{{item.price_per_hour}}/h · {{item.status === 'active' ? '正常' : item.status}}</text>
      </view>
      <text class="edit-link" bindtap="onEditVenue" data-id="{{item.id}}">编辑</text>
    </view>
    <view wx:if="{{venues.length === 0}}" class="empty-hint">暂无场地，点击上方添加</view>
  </view>

  <!-- Quick Actions -->
  <view class="section">
    <view class="section-title">快捷操作</view>
    <view class="action-list">
      <view class="action-item" bindtap="onEditClub">✏️ 编辑俱乐部信息</view>
      <view class="action-item" bindtap="onOrderManage">📋 订单管理</view>
    </view>
  </view>


  <!-- Empty State: No Clubs -->
  <view class="empty-state" wx:if="{{managedClubs.length === 0 && !loading}}">
    <text>您还没有管理的俱乐部</text>
    <button class="btn-primary" style="margin-top:40rpx" bindtap="onCreateClub">创建俱乐部</button>
  </view>

  <!-- Loading -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
