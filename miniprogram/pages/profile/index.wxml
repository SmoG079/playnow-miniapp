<!-- 我的 - 角色化个人中心 -->
<view class="page">
  <!-- Not Logged In -->
  <view class="login-prompt" wx:if="{{!isLoggedIn}}">
    <image class="login-avatar" src="/images/default-avatar.png" mode="aspectFill" />
    <text class="login-tip">登录后使用完整功能</text>
    <button class="btn-primary" bindtap="onLogin">微信登录</button>
  </view>

  <block wx:if="{{isLoggedIn}}">
    <!-- Profile Header -->
    <view class="profile-header">
      <image class="profile-avatar" src="{{userInfo.avatar_url || '/images/default-avatar.png'}}" mode="aspectFill" binderror="onImgError" />
      <view class="profile-info">
        <text class="profile-name">{{userInfo.nickname || '未设置昵称'}}</text>
        <view class="profile-role">
          <text class="tag {{role === 'club_admin' ? 'tag-primary' : 'tag-default'}}">
            {{role === 'platform_admin' ? '平台管理员' : role === 'club_admin' ? '俱乐部管理员' : '普通用户'}}
          </text>
          <text class="tag tag-ntrp" wx:if="{{userInfo.ntrp_level}}">NTRP {{userInfo.ntrp_level}}</text>
        </view>
      </view>
      <view class="edit-btn" bindtap="onEditProfile"><text>编辑</text></view>
    </view>

    <!-- Managed Clubs (if admin) -->
    <view class="card" wx:if="{{managedClubIds.length > 0}}">
      <text class="card-title">我管理的俱乐部</text>
      <text class="text-secondary text-sm">共 {{managedClubIds.length}} 个</text>
    </view>

    <!-- Menu List -->
    <view class="menu-list">
      <view wx:for="{{menuItems}}" wx:key="title" class="menu-item" data-page="{{item.page}}" bindtap="onMenuTap">
        <text class="menu-icon">{{item.icon}}</text>
        <text class="menu-title">{{item.title}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </block>

  <!-- Logout -->
  <view class="logout-area" wx:if="{{isLoggedIn}}">
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>
</view>
