.page { background: #f5f5f5; min-height: 100vh; }

.top-tabs { display: flex; background: #fff; margin-bottom: 12rpx; }
.top-tab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 30rpx; color: #666; }
.top-tab.active { color: #07c160; font-weight: 600; border-bottom: 4rpx solid #07c160; }

.card { background: #fff; margin: 12rpx 16rpx; border-radius: 12rpx; padding: 20rpx; }
.card-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.card-title { font-size: 30rpx; font-weight: 600; flex: 1; }
.card-meta { display: flex; gap: 16rpx; font-size: 24rpx; color: #999; }

.tag { padding: 4rpx 10rpx; border-radius: 6rpx; font-size: 22rpx; }
.tag-primary { background: #e8f8ee; color: #07c160; }
.tag-warning { background: #fff8e0; color: #d4a000; }
.status.open { color: #07c160; }
.status.closed { color: #999; }
.status.full { color: #f44336; }

.card-actions { margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid #f0f0f0; display: flex; gap: 12rpx; justify-content: flex-end; }
.btn-edit { font-size: 24rpx; color: #07c160; background: #fff; border: 1rpx solid #07c160; border-radius: 6rpx; padding: 4rpx 16rpx; line-height: 1.6; }
.btn-close { font-size: 24rpx; color: #f44336; background: #fff; border: 1rpx solid #f44336; border-radius: 6rpx; padding: 4rpx 16rpx; line-height: 1.6; }

/* Modal */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); z-index: 200; display: flex; align-items: flex-end; }
.modal-card { width: 100%; max-height: 80vh; background: #fff; border-radius: 24rpx 24rpx 0 0; overflow-y: auto; }
.modal-hd { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; border-bottom: 1rpx solid #eee; }
.modal-title { font-size: 32rpx; font-weight: 600; }
.modal-close { font-size: 32rpx; color: #999; }
.modal-body { padding: 20rpx 24rpx; }
.flabel { font-size: 26rpx; color: #666; display: block; margin: 12rpx 0 6rpx; }
.finput { width: 100%; height: 72rpx; border: 1rpx solid #e5e5e5; border-radius: 8rpx; padding: 0 16rpx; font-size: 28rpx; box-sizing: border-box; margin-bottom: 6rpx; }
.finput.picker-val { display: flex; align-items: center; color: #333; }
.ftextarea { width: 100%; height: 120rpx; border: 1rpx solid #e5e5e5; border-radius: 8rpx; padding: 12rpx 16rpx; font-size: 28rpx; box-sizing: border-box; }
.form-row { display: flex; gap: 12rpx; }
.btn-save { width: 100%; height: 88rpx; line-height: 88rpx; background: #07c160; color: #fff; font-size: 32rpx; border-radius: 0; border: none; }

.empty { text-align: center; padding: 80rpx 0; color: #999; font-size: 28rpx; }
