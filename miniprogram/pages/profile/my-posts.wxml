<view class="page">
  <!-- Tabs -->
  <view class="top-tabs">
    <view class="top-tab {{activeTab === 0 ? 'active' : ''}}" data-tab="0" bindtap="onTabChange">约球帖管理</view>
    <view class="top-tab {{activeTab === 1 ? 'active' : ''}}" data-tab="1" bindtap="onTabChange" wx:if="{{isAdmin}}">比赛管理</view>
  </view>

  <!-- 约球帖 -->
  <block wx:if="{{activeTab === 0}}">
    <view wx:for="{{posts}}" wx:key="id" class="card">
      <view class="card-hd">
        <text class="card-title" bindtap="onPostDetail" data-id="{{item.id}}">{{item.title}}</text>
        <text class="tag {{item.venue_id ? 'tag-warning' : 'tag-primary'}}">{{item.venue_id ? '定场' : '自由'}}</text>
      </view>
      <view class="card-meta">
        <text wx:if="{{item.preferred_date}}">📅 {{item.preferred_date}}</text>
        <text>👥 {{item.registration_count}}人报名</text>
        <text class="status {{item.status}}">{{item.status === 'open' ? '招募中' : item.status === 'closed' ? '已关闭' : '已满'}}</text>
      </view>
      <view class="card-actions" wx:if="{{item.status === 'open'}}">
        <button class="btn-edit" bindtap="onEditPost" data-id="{{item.id}}" data-title="{{item.title}}" data-date="{{item.preferred_date}}" data-start="{{item.preferred_start}}" data-end="{{item.preferred_end}}" data-needed="{{item.players_needed}}" data-price="{{item.price}}" data-level="{{item.level_required}}" data-notes="{{item.notes}}" size="mini">修改</button>
        <button class="btn-close" bindtap="onClosePost" data-id="{{item.id}}" size="mini">删除</button>
      </view>
    </view>
    <view wx:if="{{posts.length === 0}}" class="empty">暂无约球帖</view>
  </block>

  <!-- 比赛 -->
  <block wx:if="{{activeTab === 1}}">
    <view wx:for="{{tournaments}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="onTourDetail">
      <view class="card-hd">
        <text class="card-title">{{item.title}}</text>
        <text class="tag tag-primary">{{item.status === 'open' ? '报名中' : item.status === 'ongoing' ? '进行中' : item.status}}</text>
      </view>
      <view class="card-meta">
        <text>{{item.start_time}}</text>
        <text>👥 {{item.current_participants}}/{{item.max_participants || '不限'}}人</text>
      </view>
    </view>
    <view wx:if="{{tournaments.length === 0}}" class="empty">暂无比赛</view>
  </block>

  <!-- Edit Modal -->
  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="onCloseEditModal">
    <view class="modal-card" catchtap="">
      <view class="modal-hd">
        <text class="modal-title">修改活动</text>
        <text class="modal-close" bindtap="onCloseEditModal">✕</text>
      </view>
      <view class="modal-body">
        <text class="flabel">标题</text>
        <input class="finput" value="{{editForm.title}}" data-field="title" bindinput="onEditField" />
        <text class="flabel">日期</text>
        <picker mode="date" value="{{editForm.preferred_date}}" data-field="preferred_date" bindchange="onEditField">
          <view class="finput picker-val">{{editForm.preferred_date || '选择日期'}}</view>
        </picker>
        <view class="form-row">
          <text class="flabel" style="flex:1">开始</text>
          <text class="flabel" style="flex:1">结束</text>
        </view>
        <view class="form-row">
          <picker mode="time" value="{{editForm.preferred_start}}" data-field="preferred_start" bindchange="onEditField">
            <view class="finput picker-val" style="flex:1">{{editForm.preferred_start || '开始'}}</view>
          </picker>
          <picker mode="time" value="{{editForm.preferred_end}}" data-field="preferred_end" bindchange="onEditField">
            <view class="finput picker-val" style="flex:1">{{editForm.preferred_end || '结束'}}</view>
          </picker>
        </view>
        <text class="flabel">还差几人</text>
        <input class="finput" type="number" value="{{editForm.players_needed}}" data-field="players_needed" bindinput="onEditField" />
        <text class="flabel">人均费用</text>
        <input class="finput" type="digit" value="{{editForm.price}}" data-field="price" bindinput="onEditField" />
        <text class="flabel">NTRP 等级</text>
        <input class="finput" value="{{editForm.level_required}}" data-field="level_required" bindinput="onEditField" placeholder="如：2.0-3.0" />
        <text class="flabel">备注</text>
        <textarea class="ftextarea" value="{{editForm.notes}}" data-field="notes" bindinput="onEditField" placeholder="补充说明..." />
      </view>
      <button class="btn-save" bindtap="onSaveEdit">保存修改</button>
    </view>
  </view>
</view>
