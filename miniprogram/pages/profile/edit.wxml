<view class="page">
  <!-- New user welcome -->
  <view class="welcome" wx:if="{{isNewUser}}">
    <text class="welcome-title">🎉 欢迎加入网球俱乐部</text>
    <text class="welcome-desc">完善资料，开始你的网球之旅</text>
  </view>
  <view class="card">
    <view class="avatar-edit">
      <button class="avatar-wrapper" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar" src="{{avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
        <text class="avatar-tip">点击更换头像</text>
      </button>
    </view>

    <text class="form-label">昵称</text>
    <input class="form-input" placeholder="输入昵称" value="{{nickname}}" bindinput="onNicknameInput" />

    <text class="form-label">手机号</text>
    <view class="phone-row">
      <input class="form-input" style="flex:1" type="number" placeholder="预订场地和报名活动需提供" value="{{phone}}" bindinput="onPhoneInput" />
      <button class="phone-wx-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">微信获取</button>
    </view>

    <text class="form-label">NTRP 等级</text>
    <picker mode="selector" range="{{ntrpLevels}}" value="{{ntrpIndex}}" bindchange="onNtrpChange">
      <view class="form-picker">
        <text class="{{ntrpIndex > -1 ? '' : 'text-light'}}">{{ntrpIndex > -1 ? ntrpLevels[ntrpIndex] : '选择你的网球等级'}}</text>
        <text class="arrow">›</text>
      </view>
    </picker>
  </view>

  <view class="submit-area">
    <button class="btn-primary" bindtap="onSubmit" loading="{{loading}}">保存</button>
  </view>
</view>
