.page { padding: 24rpx; padding-bottom: 60rpx; }

.club-header { margin: 0 0 20rpx 0; position: relative; }
.club-cover { width: 100%; height: 240rpx; border-radius: var(--radius); display: block; margin-bottom: 16rpx; }
.club-name { font-size: 34rpx; font-weight: 700; display: block; margin-bottom: 6rpx; }
.edit-link { font-size: 26rpx; color: var(--primary); margin-top: 8rpx; display: inline-block; }

.stats-grid { display: flex; gap: 16rpx; margin-bottom: 28rpx; }
.stat-item { flex: 1; background: var(--bg-white); border-radius: var(--radius); padding: 20rpx; text-align: center; box-shadow: var(--shadow); }
.stat-val { font-size: 36rpx; font-weight: 700; color: var(--primary); display: block; }
.stat-label { font-size: 22rpx; color: var(--text-secondary); margin-top: 6rpx; display: block; }

.section { margin-bottom: 28rpx; }
.section-header { margin-bottom: 16rpx; }
.section-title { font-size: 30rpx; font-weight: 600; }

.venue-row { margin: 0 0 12rpx 0; display: flex; align-items: center; }
.venue-name { font-size: 28rpx; font-weight: 500; display: block; margin-bottom: 4rpx; }

.action-list { margin: 0; }
.action-item { padding: 20rpx 0; border-bottom: 1rpx solid var(--border); font-size: 28rpx; }
.action-item:last-child { border-bottom: none; }

.empty-state { text-align: center; padding: 100rpx 0; color: var(--text-secondary); }
