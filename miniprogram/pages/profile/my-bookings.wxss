.page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* Tabs */
.tab-bar {
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
  white-space: nowrap;
}

.tab-list {
  display: flex;
  padding: 0 20rpx;
}

.tab-item {
  display: inline-flex;
  padding: 20rpx 30rpx;
}

.tab-item.active {
  border-bottom: 4rpx solid #4CD964;
}

.tab-item.active .tab-text {
  font-weight: 600;
  color: #333;
}

.tab-text {
  font-size: 28rpx;
  color: #999;
}

/* Booking List */
.booking-list {
  padding: 20rpx;
}

.booking-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999;
  font-family: monospace;
}

.status-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.status-badge.orange {
  background-color: #fff3e0;
  color: #e65100;
}

.status-badge.green {
  background-color: #e8f5e9;
  color: #2e7d32;
}

.status-badge.blue {
  background-color: #e3f2fd;
  color: #1565c0;
}

.status-badge.gray {
  background-color: #eeeeee;
  color: #757575;
}

.status-badge.red {
  background-color: #ffebee;
  color: #c62828;
}

/* Card Body */
.card-body {
  padding: 16rpx 0;
  border-top: 1rpx solid #f5f5f5;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.info-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.info-text {
  font-size: 26rpx;
  color: #666;
}

.info-row.club .info-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* Card Footer */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
}

.amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff6b6b;
}

.actions {
  display: flex;
  align-items: center;
}

.btn-cancel {
  font-size: 26rpx;
  color: #f44336;
  padding: 8rpx 24rpx;
  border: 1rpx solid #f44336;
  border-radius: 8rpx;
}

.btn-pay-now {
  font-size: 26rpx;
  color: #fff;
  background-color: #07c160;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

/* Load More */
.load-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

/* Empty / Loading */
.empty-state,
.loading-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #999;
  font-size: 30rpx;
}
