.page { padding: 0 24rpx; }
.filter-scroll { white-space: nowrap; padding: 20rpx 0; }
.filter-item {
  display: inline-block; padding: 12rpx 28rpx; margin-right: 16rpx;
  border-radius: 30rpx; font-size: 26rpx; color: var(--text-secondary);
  background: var(--bg-white); border: 1rpx solid var(--border);
}
.filter-item.active { background: var(--primary); color: #fff; border-color: var(--primary); }

.booking-card { margin: 0 0 20rpx 0; }
.booking-header { margin-bottom: 16rpx; }
.venue-name { font-size: 30rpx; font-weight: 600; color: var(--text); }
.booking-status { font-size: 24rpx; padding: 4rpx 12rpx; border-radius: 6rpx; }
.booking-status.pending { background: #fff8e0; color: #d4a000; }
.booking-status.paid { background: #e8f8ee; color: var(--primary); }
.booking-status.completed { background: #e8f0fe; color: #4a90d9; }
.booking-status.cancelled { background: #f0f0f0; color: var(--text-secondary); }
.booking-status.refunding { background: #fde8e8; color: var(--danger); }
.booking-status.refunded { background: #f0f0f0; color: var(--text-secondary); }

.booking-body { border-top: 1rpx solid var(--border); border-bottom: 1rpx solid var(--border); padding: 12rpx 0; }
.info-row { display: flex; justify-content: space-between; padding: 8rpx 0; }
.info-label { font-size: 26rpx; color: var(--text-secondary); }
.info-value { font-size: 26rpx; color: var(--text); }

.booking-footer { padding-top: 16rpx; }
.btn-cancel {
  float: right; font-size: 24rpx; color: var(--danger);
  background: transparent; border: 1rpx solid var(--danger);
  border-radius: 8rpx; padding: 8rpx 24rpx; line-height: 1.4;
}
.btn-cancel[disabled] { color: var(--text-light); border-color: var(--border); }

.empty-state { text-align: center; padding: 100rpx 0; color: var(--text-secondary); font-size: 28rpx; }
