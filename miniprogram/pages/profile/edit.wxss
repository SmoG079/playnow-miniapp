.page { padding: 20rpx; padding-bottom: 160rpx; }

.welcome { text-align: center; padding: 40rpx 0 20rpx; }

.phone-row { display: flex; gap: 12rpx; align-items: center; }
.phone-wx-btn { flex-shrink: 0; height: 80rpx; line-height: 80rpx; padding: 0 20rpx; background: #07c160; color: #fff; font-size: 24rpx; border-radius: 8rpx; border: none; }
.welcome-title { font-size: 36rpx; font-weight: 700; color: #333; display: block; margin-bottom: 8rpx; }
.welcome-desc { font-size: 28rpx; color: #999; }

.avatar-edit { display: flex; justify-content: center; margin-bottom: 24rpx; }
.avatar-edit .avatar-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  padding: 0;
  margin: 0;
  line-height: normal;
  border: none;
}
.avatar-edit .avatar-wrapper::after { border: none; }
.avatar-edit .avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
}
.avatar-edit .avatar-tip { font-size: 26rpx; color: #999; }

.form-label { display: block; font-size: 28rpx; font-weight: 500; margin: 24rpx 0 12rpx; color: var(--text); }
.form-label:first-child { margin-top: 0; }

.form-input { background: #fff; border-radius: 8rpx; padding: 20rpx; font-size: 28rpx; }

.form-picker { background: #fff; border-radius: 8rpx; padding: 20rpx; font-size: 28rpx; display: flex; justify-content: space-between; align-items: center; }
.form-picker .arrow { font-size: 30rpx; color: #ccc; }

.text-light { color: #999; }

.submit-area { padding: 40rpx 20rpx; }
.submit-area .btn-primary { width: 100%; border-radius: 44rpx; padding: 24rpx; font-size: 32rpx; }
