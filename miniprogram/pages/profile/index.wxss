.page { padding-bottom: env(safe-area-inset-bottom); }

.login-prompt { display: flex; flex-direction: column; align-items: center; padding: 120rpx 60rpx; gap: 30rpx; }
.login-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: #eee; }
.login-tip { font-size: 28rpx; color: var(--text-secondary); }
.login-prompt .btn-primary { width: 80%; border-radius: 44rpx; padding: 24rpx; }

.profile-header { display: flex; align-items: center; gap: 24rpx; padding: 30rpx; background: #fff; }
.profile-avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: #eee; }
.profile-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.profile-name { font-size: 34rpx; font-weight: 600; }
.profile-role { display: flex; gap: 12rpx; flex-wrap: wrap; }
.tag-ntrp { background: #e3f2fd; color: #1976d2; }

.card-title { font-size: 28rpx; font-weight: 600; }

.menu-list { background: #fff; margin-top: 12rpx; }
.menu-item { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 30rpx; border-bottom: 1rpx solid #f6f6f6; }
.menu-icon { font-size: 36rpx; width: 48rpx; text-align: center; }
.menu-title { flex: 1; font-size: 28rpx; }
.menu-arrow { font-size: 30rpx; color: #ccc; }

.logout-area { padding: 40rpx 30rpx; }
.logout-btn { width: 100%; height: 80rpx; line-height: 80rpx; background: #fff; color: #f44336; font-size: 30rpx; border: 1rpx solid #f44336; border-radius: 40rpx; }
