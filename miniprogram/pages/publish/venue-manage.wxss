.page { background: #f5f5f5; min-height: 100vh; padding-bottom: 100rpx; }

.float-header {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: #fff; display: flex; align-items: center;
  justify-content: space-between; padding: 0 24rpx 12rpx;
  box-shadow: 0 1rpx 6rpx rgba(0,0,0,0.06);
}
.back-btn { font-size: 30rpx; color: #07c160; }
.header-title { font-size: 32rpx; font-weight: 600; color: #333; }

.card { background: #fff; margin: 16rpx 20rpx; border-radius: 12rpx; padding: 24rpx; }
.flabel { font-size: 28rpx; color: #333; font-weight: 500; display: block; margin: 20rpx 0 10rpx; }
.finput { width: 100%; height: 80rpx; border: 1rpx solid #e5e5e5; border-radius: 8rpx; padding: 0 16rpx; font-size: 28rpx; box-sizing: border-box; margin-bottom: 10rpx; }
.rule-pick { display: flex; align-items: center; color: #333; }

.rules-section { margin-top: 20rpx; border-top: 1rpx solid #eee; padding-top: 12rpx; }
.rules-hd { display: flex; justify-content: space-between; align-items: center; }
.add-link { font-size: 26rpx; color: #07c160; }
.rule-card { position: relative; background: #f9f9f9; border-radius: 8rpx; padding: 16rpx; margin: 12rpx 0; }
.rule-remove { position: absolute; top: 8rpx; right: 12rpx; color: #f44336; font-size: 28rpx; }

.submit-area { padding: 20rpx 20rpx; }
.btn-save { width: 100%; height: 88rpx; line-height: 88rpx; background: #07c160; color: #fff; font-size: 32rpx; border-radius: 44rpx; border: none; }
