.page { padding: 24rpx; padding-bottom: 120rpx; }

.venue-card { margin: 0 0 16rpx 0; }
.venue-info { margin-bottom: 16rpx; }
.venue-name { font-size: 30rpx; font-weight: 600; display: block; margin-bottom: 6rpx; }
.venue-status { display: inline-block; font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 6rpx; margin-top: 8rpx; }
.venue-status.active { background: #e8f8ee; color: var(--primary); }
.venue-status.maintenance { background: #fff8e0; color: #d4a000; }
.venue-status.closed { background: #f0f0f0; color: var(--text-secondary); }

.venue-actions { display: flex; gap: 32rpx; border-top: 1rpx solid var(--border); padding-top: 16rpx; }
.action-link { font-size: 26rpx; color: var(--text-secondary); }

.add-btn-wrap { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 24rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); background: var(--bg-white); }

.empty-state { text-align: center; padding: 100rpx 0; color: var(--text-secondary); }

/* Modal */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); z-index: 100; }
.modal-form { position: fixed; bottom: 0; left: 0; right: 0; background: var(--bg-white); border-radius: 24rpx 24rpx 0 0; padding: 32rpx 24rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); z-index: 101; max-height: 80vh; overflow-y: auto; }
.form-header { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; }
.form-group { margin-bottom: 24rpx; }
.form-group.flex-1 { flex: 1; margin-bottom: 0; }
.form-label { font-size: 26rpx; color: var(--text-secondary); display: block; margin-bottom: 12rpx; }
.form-input { width: 100%; height: 80rpx; border: 1rpx solid var(--border); border-radius: 12rpx; padding: 0 20rpx; font-size: 28rpx; box-sizing: border-box; display: flex; align-items: center; }
.form-input.picker-val { line-height: 80rpx; }

.form-row { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 24rpx; }
.time-sep { padding-top: 44rpx; font-size: 28rpx; color: var(--text-secondary); flex-shrink: 0; }

.form-hint { font-size: 24rpx; color: var(--text-light); display: block; margin-top: 8rpx; }
