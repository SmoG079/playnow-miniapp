<view class="page">
  <view class="post-header" wx:if="{{post}}">
    <text class="post-title">{{post.title}}</text>
    <view class="post-meta">
      <text class="meta-item">已报名 {{post.registration_count}}/{{post.players_needed}}</text>
      <text class="meta-item pending" wx:if="{{post.pending_count > 0}}">待审核 {{post.pending_count}}</text>
    </view>
  </view>

  <view class="tab-bar">
    <view
      wx:for="{{[['pending', '待审核'], ['approved', '已通过'], ['rejected', '已拒绝']]}}"
      wx:key="*this"
      class="tab-item {{activeTab === item[0] ? 'active' : ''}}"
      data-tab="{{item[0]}}"
      bindtap="onTabChange"
    >{{item[1]}}</view>
  </view>

  <view class="reg-list" wx:if="{{!loading}}">
    <block wx:for="{{filteredRegistrations}}" wx:key="id">
      <view class="reg-card">
        <view class="reg-user">
          <image class="reg-avatar" src="{{item.user_avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
          <view class="reg-info">
            <text class="reg-name">{{item.user_nickname || ('用户' + item.user_id)}}</text>
            <text class="reg-time">{{item.created_at}}</text>
          </view>
        </view>
        <text wx:if="{{item.message}}" class="reg-message">留言：{{item.message}}</text>

        <view class="reg-actions" wx:if="{{item.status === 'pending'}}">
          <view class="btn-reject" data-user-id="{{item.user_id}}" data-status="rejected" bindtap="onReview">拒绝</view>
          <view class="btn-approve" data-user-id="{{item.user_id}}" data-status="approved" bindtap="onReview">通过</view>
        </view>
      </view>
    </block>

    <view wx:if="{{filteredRegistrations.length === 0}}" class="empty-state">
      <text>暂无{{activeTab === 'pending' ? '待审核' : activeTab === 'approved' ? '已通过' : '已拒绝'}}报名</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>
</view>
