.page { padding-bottom: env(safe-area-inset-bottom); }

.post-header { padding: 24rpx 30rpx; background: #fff; margin-bottom: 16rpx; }
.post-title { font-size: 32rpx; font-weight: 600; }
.post-meta { display: flex; gap: 24rpx; margin-top: 12rpx; }
.meta-item { font-size: 26rpx; color: #666; }
.meta-item.pending { color: #ff9800; }

.tab-bar { display: flex; background: #fff; border-bottom: 1rpx solid #eee; }
.tab-item { flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: #666; position: relative; }
.tab-item.active { color: var(--primary); font-weight: 600; }
.tab-item.active::after { content: ''; position: absolute; bottom: 0; left: 30%; right: 30%; height: 4rpx; background: var(--primary); border-radius: 2rpx; }

.reg-list { padding: 20rpx; }
.reg-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.reg-user { display: flex; align-items: center; gap: 16rpx; }
.reg-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: #eee; }
.reg-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.reg-name { font-size: 30rpx; font-weight: 500; }
.reg-time { font-size: 24rpx; color: #999; }
.reg-message { margin-top: 16rpx; padding: 16rpx; background: #f5f5f5; border-radius: 8rpx; font-size: 28rpx; color: #333; }

.reg-actions { display: flex; justify-content: flex-end; gap: 20rpx; margin-top: 24rpx; }
.btn-approve, .btn-reject { padding: 12rpx 32rpx; border-radius: 30rpx; font-size: 28rpx; }
.btn-approve { background: var(--primary); color: #fff; }
.btn-reject { background: #f5f5f5; color: #666; }

.empty-state { text-align: center; padding: 120rpx 0; color: #999; font-size: 28rpx; }
.loading-state { text-align: center; padding: 120rpx 0; color: #999; }
