.page { padding: 20rpx; padding-bottom: 160rpx; }

.form-label { display: block; font-size: 28rpx; font-weight: 500; margin: 24rpx 0 12rpx; color: var(--text); }
.form-input { background: #fff; border-radius: 8rpx; padding: 20rpx; font-size: 28rpx; }
.form-textarea { background: #fff; border-radius: 8rpx; padding: 20rpx; font-size: 28rpx; min-height: 120rpx; width: 100%; box-sizing: border-box; }
.form-picker { display: flex; justify-content: space-between; align-items: center; background: #fff; border-radius: 8rpx; padding: 20rpx; font-size: 28rpx; }
.form-row { display: flex; align-items: center; gap: 16rpx; }
.form-picker-half { flex: 1; background: #fff; border-radius: 8rpx; padding: 20rpx; text-align: center; font-size: 28rpx; }
.form-divider { color: var(--text-light); }

.mode-switch { display: flex; gap: 16rpx; }
.mode-item { flex: 1; text-align: center; padding: 20rpx; border-radius: 12rpx; font-size: 26rpx; background: #fff; border: 2rpx solid var(--border); transition: all 0.2s; }
.mode-item.active { border-color: var(--primary); background: #e8f8ee; color: var(--primary); font-weight: 600; }

/* Date tabs */
.date-scroll { white-space: nowrap; padding: 4rpx 0; }
.date-tab { display: inline-block; padding: 10rpx 24rpx; margin-right: 12rpx; border-radius: 20rpx; font-size: 24rpx; background: #f0f0f0; color: var(--text-secondary); }
.date-tab.active { background: var(--primary); color: #fff; }

/* Slot grid */
.slot-grid { display: flex; flex-direction: column; gap: 6rpx; margin: 12rpx 0; max-height: 360rpx; overflow-y: auto; }
.slot-item { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 16rpx; border-radius: 8rpx; background: #fff; border: 2rpx solid var(--border); font-size: 24rpx; }
.slot-item.available { border-color: #c8e6c9; background: #f1f8e9; }
.slot-item.booked { background: #e0e0e0; opacity: 0.5; }
.slot-item.locked { background: #f5f5f5; opacity: 0.5; }
.slot-item.selected { border-color: #f0a020; background: #fff3cd; }
.slot-item.selected .slot-time { font-weight: 700; color: #8b6914; }
.slot-time { flex: 1; }
.slot-price { min-width: 60rpx; text-align: right; color: var(--text-secondary); }
.slot-tag { font-size: 20rpx; padding: 2rpx 8rpx; border-radius: 4rpx; background: #eee; color: #999; }
.slot-tick { color: #f0a020; font-weight: 700; }
.slot-selected { margin-top: 12rpx; padding: 12rpx; background: #fff3cd; border-radius: 8rpx; text-align: center; }
.form-hint { font-size: 22rpx; color: var(--text-light); display: block; margin-top: 6rpx; }

.submit-area { margin-top: 30rpx; }
.submit-area .btn-primary { width: 100%; border-radius: 44rpx; padding: 24rpx; font-size: 32rpx; }
