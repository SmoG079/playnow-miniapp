.page { padding: 20rpx; padding-bottom: 160rpx; }

.form-label { display: block; font-size: 28rpx; font-weight: 500; margin: 24rpx 0 12rpx; color: var(--text); }
.form-input { background: #fff; border-radius: 8rpx; padding: 20rpx; font-size: 28rpx; }
.form-textarea { background: #fff; border-radius: 8rpx; padding: 20rpx; font-size: 28rpx; min-height: 120rpx; width: 100%; box-sizing: border-box; }
.form-picker { display: flex; justify-content: space-between; align-items: center; background: #fff; border-radius: 8rpx; padding: 20rpx; font-size: 28rpx; }
.form-row { display: flex; align-items: center; gap: 16rpx; }
.form-picker-half { flex: 1; background: #fff; border-radius: 8rpx; padding: 20rpx; text-align: center; font-size: 28rpx; }
.form-divider { color: var(--text-light); }

.submit-area { margin-top: 30rpx; }
.submit-area .btn-primary { width: 100%; border-radius: 44rpx; padding: 24rpx; font-size: 32rpx; }
.form-tip { display: block; text-align: center; margin-top: 16rpx; font-size: 24rpx; color: #999; }

.document-list { margin-top: 12rpx; }
.doc-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.doc-icon { font-size: 36rpx; margin-right: 16rpx; }
.doc-name { flex: 1; font-size: 28rpx; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.doc-remove { font-size: 32rpx; color: #ff5252; padding: 0 10rpx; }
.doc-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 8rpx;
  padding: 24rpx;
  border: 2rpx dashed #ddd;
}
.doc-add-icon { font-size: 36rpx; color: #999; margin-right: 12rpx; }
.doc-add-text { font-size: 28rpx; color: #999; }

.img-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }
.img-item { width: 150rpx; height: 150rpx; position: relative; border-radius: 8rpx; overflow: hidden; }
.img-item image { width: 100%; height: 100%; }
.img-remove { position: absolute; top: 0; right: 0; width: 40rpx; height: 40rpx; background: rgba(0,0,0,0.5); color: #fff; font-size: 28rpx; display: flex; align-items: center; justify-content: center; border-radius: 0 8rpx 0 8rpx; }
.img-add { width: 150rpx; height: 150rpx; background: #f5f5f5; border-radius: 8rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed #ddd; }
.img-add .add-icon { font-size: 48rpx; color: #999; }
.img-add .add-text { font-size: 22rpx; color: #999; margin-top: 4rpx; }

.mode-toggle { display: flex; gap: 16rpx; margin: 12rpx 0; }
.mode-btn { flex: 1; text-align: center; padding: 18rpx; border-radius: 12rpx; font-size: 28rpx; background: #f5f5f5; color: #666; border: 2rpx solid transparent; }
.mode-btn.active { background: #e8f5e9; color: #2e7d32; border-color: #4caf50; font-weight: 600; }

.linked-booking { background: #e8f5e9; border-radius: 8rpx; padding: 16rpx; margin: 16rpx 0; display: flex; flex-direction: column; gap: 6rpx; }
.linked-label { font-size: 26rpx; font-weight: 600; color: #2e7d32; }
.linked-clear { font-size: 24rpx; color: #f44336; }
.btn-book-venue { width: 100%; height: 80rpx; line-height: 80rpx; background: #e8f5e9; color: #2e7d32; border: 2rpx dashed #4caf50; border-radius: 12rpx; font-size: 28rpx; margin: 16rpx 0; }
.btn-book-venue[disabled] { opacity: 0.5; }

.level-section { background: #fff; border-radius: 8rpx; padding: 24rpx; }
.level-display { font-size: 32rpx; font-weight: 600; color: #333; text-align: center; margin-bottom: 24rpx; }
.slider-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.slider-label { font-size: 26rpx; color: #666; width: 56rpx; }
.level-slider { flex: 1; }
.slider-value { font-size: 26rpx; color: #5CD29D; width: 72rpx; text-align: right; }
.level-scale { display: flex; justify-content: space-between; padding: 0 76rpx 0 76rpx; }
.scale-item { font-size: 20rpx; color: #999; }
