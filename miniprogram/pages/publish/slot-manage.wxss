.page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.form-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.form-picker {
  height: 80rpx;
  line-height: 80rpx;
  border-bottom: 1rpx solid #eee;
  font-size: 30rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-arrow {
  color: #999;
  font-size: 28rpx;
}

.date-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.date-picker {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-bottom: 1rpx solid #eee;
  font-size: 30rpx;
  color: #333;
  text-align: center;
}

.date-sep {
  font-size: 28rpx;
  color: #999;
}

.btn-generate {
  background-color: #4CD964;
  color: #fff;
  border-radius: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border: none;
  margin: 40rpx 0;
}

.btn-generate.disabled {
  background-color: #ccc;
}

.result-card {
  background-color: #e8f5e9;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.result-title {
  font-size: 28rpx;
  color: #2e7d32;
  display: block;
  margin-bottom: 12rpx;
}

.result-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #4CAF50;
  display: block;
}

.result-hint {
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
  display: block;
}

.hint-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.hint-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.hint-text {
  font-size: 26rpx;
  color: #999;
  display: block;
  line-height: 1.8;
}

.slot-list-card { margin-top: 20rpx; background-color: #fff; border-radius: 16rpx; padding: 30rpx; }
.slot-list-card .result-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; display: block; color: #333; }

.slot-list { display: flex; flex-direction: column; gap: 16rpx; }
.slot-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx; background: #f8f8f8; border-radius: 12rpx; }
.slot-info { display: flex; flex-direction: column; gap: 6rpx; }
.slot-date { font-size: 26rpx; color: #666; }
.slot-time { font-size: 30rpx; font-weight: 500; color: #333; }
.slot-price { font-size: 26rpx; color: #ff9500; }

.slot-status { display: flex; align-items: center; gap: 12rpx; }
.status-text { font-size: 26rpx; }
.status-text.available { color: #4CAF50; }
.status-text.maintenance { color: #999; }
.status-text.booked { color: #f44336; }
.status-text.locked { color: #ff9800; }

.toggle-btn { margin: 0; font-size: 24rpx; color: #fff; }
.toggle-btn.disable { background: #f44336; }
.toggle-btn.enable { background: #4CAF50; }

.empty-state { text-align: center; padding: 60rpx 0; color: #999; }
.loading-state { text-align: center; padding: 60rpx 0; color: #999; }
