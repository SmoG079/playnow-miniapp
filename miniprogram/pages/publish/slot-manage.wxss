.page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.form-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.form-picker {
  height: 80rpx;
  line-height: 80rpx;
  border-bottom: 1rpx solid #eee;
  font-size: 30rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-arrow {
  color: #999;
  font-size: 28rpx;
}

.date-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.date-picker {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-bottom: 1rpx solid #eee;
  font-size: 30rpx;
  color: #333;
  text-align: center;
}

.date-sep {
  font-size: 28rpx;
  color: #999;
}

.btn-generate {
  background-color: #4CD964;
  color: #fff;
  border-radius: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border: none;
  margin: 40rpx 0;
}

.btn-generate.disabled {
  background-color: #ccc;
}

.result-card {
  background-color: #e8f5e9;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.result-title {
  font-size: 28rpx;
  color: #2e7d32;
  display: block;
  margin-bottom: 12rpx;
}

.result-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #4CAF50;
  display: block;
}

.result-hint {
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
  display: block;
}

.hint-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.hint-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.hint-text {
  font-size: 26rpx;
  color: #999;
  display: block;
  line-height: 1.8;
}
