.page { padding: 20rpx; padding-bottom: 160rpx; }

.form-label { display: block; font-size: 28rpx; font-weight: 500; margin: 24rpx 0 12rpx; color: var(--text); }
.form-input { background: #fff; border-radius: 8rpx; padding: 20rpx; font-size: 28rpx; }
.form-textarea { background: #fff; border-radius: 8rpx; padding: 20rpx; font-size: 28rpx; min-height: 160rpx; width: 100%; box-sizing: border-box; }

.sport-check-group { display: flex; flex-wrap: wrap; gap: 16rpx; }
.sport-check { padding: 12rpx 28rpx; border-radius: 30rpx; background: #fff; font-size: 26rpx; border: 2rpx solid #e5e5e5; }
.sport-check.checked { background: #e8f8ee; color: var(--primary); border-color: var(--primary); }

.submit-area { padding: 20rpx 0; }
.submit-area .btn-primary { width: 100%; border-radius: 44rpx; padding: 24rpx; font-size: 32rpx; }
