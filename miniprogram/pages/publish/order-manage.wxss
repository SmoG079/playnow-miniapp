.page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* Tabs */
.tab-bar {
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
  white-space: nowrap;
}

.tab-list {
  display: flex;
  padding: 0 20rpx;
}

.tab-item {
  display: inline-flex;
  padding: 20rpx 30rpx;
}

.tab-item.active {
  border-bottom: 4rpx solid #4CD964;
}

.tab-item.active .tab-text {
  font-weight: 600;
  color: #333;
}

.tab-text {
  font-size: 28rpx;
  color: #999;
}

/* Order List */
.order-list {
  padding: 20rpx;
}

.order-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999;
  font-family: monospace;
}

.order-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.order-status.green {
  background-color: #e8f5e9;
  color: #2e7d32;
}

.order-status.orange {
  background-color: #fff3e0;
  color: #e65100;
}

.order-status.blue {
  background-color: #e3f2fd;
  color: #1565c0;
}

.order-status.gray {
  background-color: #eeeeee;
  color: #757575;
}

.order-status.red {
  background-color: #ffebee;
  color: #c62828;
}

.order-time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.order-body {
  padding: 16rpx 0;
  border-top: 1rpx solid #f5f5f5;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-venue,
.order-slot,
.order-user {
  font-size: 26rpx;
  color: #666;
  padding: 4rpx 0;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
}

.order-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff6b6b;
}

.action-cancel {
  font-size: 26rpx;
  color: #f44336;
  padding: 8rpx 24rpx;
  border: 1rpx solid #f44336;
  border-radius: 8rpx;
}

/* Load More */
.load-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

/* Empty / Loading */
.empty-state,
.loading-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #999;
  font-size: 30rpx;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  background-color: #fff;
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx;
}

.detail-section {
  margin-bottom: 30rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.detail-label {
  font-size: 28rpx;
  color: #999;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  max-width: 60%;
}

.detail-value.amount {
  font-size: 36rpx;
  font-weight: 600;
  color: #ff6b6b;
}

.detail-value.status-green {
  color: #2e7d32;
}

.detail-value.status-orange {
  color: #e65100;
}

.detail-value.status-blue {
  color: #1565c0;
}

.detail-value.status-gray {
  color: #757575;
}

.detail-value.status-red {
  color: #c62828;
}

.detail-divider {
  height: 1rpx;
  background-color: #f5f5f5;
  margin: 8rpx 0;
}

.btn-cancel-order {
  background-color: #fff;
  color: #f44336;
  border: 1rpx solid #f44336;
  border-radius: 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
}
