<view class="page">
  <!-- Status Tabs -->
  <scroll-view class="tab-bar" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tab-list">
      <view
        wx:for="{{statusTabs}}"
        wx:key="value"
        class="tab-item {{activeStatus === item.value ? 'active' : ''}}"
        data-status="{{item.value}}"
        bindtap="onTabChange"
      >
        <text class="tab-text">{{item.label}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- Order List -->
  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view
      class="order-card"
      wx:for="{{orders}}"
      wx:key="id"
      data-order="{{item}}"
      bindtap="onOrderTap"
    >
      <view class="order-header">
        <text class="order-no">{{item.order_no}}</text>
        <text class="order-status {{statusColor(item.status)}}">{{formatStatus(item.status)}}</text>
      </view>
      <view class="order-time">{{item.created_at}}</view>

      <view class="order-body">
        <view class="order-venue">🏟️ {{item.venue_name || '未知场地'}}</view>
        <view class="order-slot">
          {{item.slot_date}} {{item.slot_start}} ~ {{item.slot_end}}
        </view>
        <view class="order-user" wx:if="{{item.user_nickname}}">
          👤 {{item.user_nickname}}
        </view>
      </view>

      <view class="order-footer">
        <text class="order-amount">¥{{item.amount}}</text>
        <view class="order-actions" catchtap="stopPropagation">
          <text
            class="action-cancel"
            wx:if="{{item.status === 'pending' || item.status === 'paid'}}"
            data-order="{{item}}"
            bindtap="onCancelOrder"
          >取消</text>
        </view>
      </view>
    </view>

    <view class="load-more" wx:if="{{!hasMore && orders.length > 0}}">
      <text>没有更多了</text>
    </view>
  </view>

  <!-- Empty State -->
  <view class="empty-state" wx:if="{{orders.length === 0 && !loading}}">
    <text>暂无订单</text>
  </view>

  <!-- Loading -->
  <view class="loading-state" wx:if="{{loading && orders.length === 0}}">
    <text>加载中...</text>
  </view>

  <!-- Detail Modal -->
  <view class="modal-mask" wx:if="{{showDetail}}" bindtap="onCloseDetail">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">订单详情</text>
        <text class="modal-close" bindtap="onCloseDetail">✕</text>
      </view>

      <view class="detail-section" wx:if="{{selectedOrder}}">
        <view class="detail-row">
          <text class="detail-label">订单编号</text>
          <text class="detail-value">{{selectedOrder.order_no}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">订单状态</text>
          <text class="detail-value status-{{statusColor(selectedOrder.status)}}">
            {{formatStatus(selectedOrder.status)}}
          </text>
        </view>
        <view class="detail-row">
          <text class="detail-label">下单时间</text>
          <text class="detail-value">{{selectedOrder.created_at}}</text>
        </view>
        <view class="detail-divider"></view>
        <view class="detail-row">
          <text class="detail-label">场地</text>
          <text class="detail-value">{{selectedOrder.venue_name || '-'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">时段</text>
          <text class="detail-value">
            {{selectedOrder.slot_date}} {{selectedOrder.slot_start}} ~ {{selectedOrder.slot_end}}
          </text>
        </view>
        <view class="detail-divider"></view>
        <view class="detail-row">
          <text class="detail-label">金额</text>
          <text class="detail-value amount">¥{{selectedOrder.amount}}</text>
        </view>
        <view class="detail-row" wx:if="{{selectedOrder.payment_time}}">
          <text class="detail-label">支付时间</text>
          <text class="detail-value">{{selectedOrder.payment_time}}</text>
        </view>
        <view class="detail-row" wx:if="{{selectedOrder.cancel_reason}}">
          <text class="detail-label">取消原因</text>
          <text class="detail-value">{{selectedOrder.cancel_reason}}</text>
        </view>
      </view>

      <button
        class="btn-cancel-order"
        wx:if="{{selectedOrder && (selectedOrder.status === 'pending' || selectedOrder.status === 'paid')}}"
        data-order="{{selectedOrder}}"
        bindtap="onCancelOrder"
      >取消订单</button>
    </view>
  </view>
</view>
