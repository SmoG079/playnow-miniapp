<view class="page" style="padding-top:{{statusBarH + 44}}px">
  <!-- Floating Header -->
  <view class="float-header" style="padding-top:{{statusBarH}}px">
    <view class="back-btn" bindtap="onBack">‹ 返回</view>
    <text class="header-title">{{isEdit ? '编辑场地' : '添加场地'}}</text>
    <view style="width:80rpx"></view>
  </view>

  <!-- Form -->
  <view class="card">
    <text class="flabel">场地名称 *</text>
    <input class="finput" value="{{form.name}}" data-field="name" bindinput="onField" placeholder="如：1号网球场" />

    <text class="flabel">每小时价格（元）*</text>
    <input class="finput" type="digit" value="{{form.price_per_hour}}" data-field="price_per_hour" bindinput="onField" placeholder="80" />

    <!-- Price Rules -->
    <view class="rules-section">
      <view class="rules-hd">
        <text class="flabel" style="margin-bottom:0">特殊价格规则</text>
        <text class="add-link" bindtap="onAddRule">+ 添加规则</text>
      </view>

      <view wx:for="{{form.price_rules}}" wx:key="idx" class="rule-card" wx:for-index="idx">
        <text class="rule-remove" bindtap="onRemoveRule" data-idx="{{idx}}">✕</text>

        <picker bindchange="onRuleTypeChange" data-idx="{{idx}}" value="{{item.type === 'daily_time' ? 1 : 0}}" range="{{['日期范围','每天时段']}}">
          <view class="finput rule-pick">{{item.type === 'daily_time' ? '每天时段' : '日期范围'}}</view>
        </picker>

        <block wx:if="{{item.type !== 'daily_time'}}">
          <picker mode="date" value="{{item.start_date}}" data-idx="{{idx}}" data-field="start_date" bindchange="onRuleField">
            <view class="finput rule-pick">{{item.start_date || '开始日期'}}</view>
          </picker>
          <picker mode="date" value="{{item.end_date}}" data-idx="{{idx}}" data-field="end_date" bindchange="onRuleField">
            <view class="finput rule-pick">{{item.end_date || '结束日期'}}</view>
          </picker>
          <picker mode="time" value="{{item.start_time}}" data-idx="{{idx}}" data-field="start_time" bindchange="onRuleField">
            <view class="finput rule-pick">{{item.start_time || '开始时间（可选）'}}</view>
          </picker>
          <picker mode="time" value="{{item.end_time}}" data-idx="{{idx}}" data-field="end_time" bindchange="onRuleField">
            <view class="finput rule-pick">{{item.end_time || '结束时间（可选）'}}</view>
          </picker>
        </block>
        <block wx:else>
          <picker mode="time" value="{{item.start_time}}" data-idx="{{idx}}" data-field="start_time" bindchange="onRuleField">
            <view class="finput rule-pick">{{item.start_time || '开始时间'}}</view>
          </picker>
          <picker mode="time" value="{{item.end_time}}" data-idx="{{idx}}" data-field="end_time" bindchange="onRuleField">
            <view class="finput rule-pick">{{item.end_time || '结束时间'}}</view>
          </picker>
        </block>

        <input class="finput" type="digit" value="{{item.price}}" data-idx="{{idx}}" data-field="price" bindinput="onRuleField" placeholder="特殊价格（元/小时）" />
      </view>
    </view>
  </view>

  <view class="submit-area">
    <button class="btn-save" bindtap="onSubmit" loading="{{loading}}" disabled="{{loading}}">保存</button>
  </view>
</view>
