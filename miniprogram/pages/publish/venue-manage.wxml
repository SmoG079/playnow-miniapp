<view class="page">
  <!-- Venue List -->
  <view class="venue-list" wx:if="{{venues.length > 0}}">
    <view class="venue-card" wx:for="{{venues}}" wx:key="id">
      <view class="venue-main">
        <view class="venue-header">
          <text class="venue-name">{{item.name}}</text>
          <text class="venue-status {{item.status}}">
            {{item.status === 'active' ? '正常' : item.status === 'maintenance' ? '维护中' : '已关闭'}}
          </text>
        </view>
        <view class="venue-tags">
          <text class="tag sport">{{item.sport_type}}</text>
          <text class="tag price">¥{{item.price_per_hour}}/小时</text>
          <text class="tag capacity">限{{item.max_capacity}}人</text>
        </view>
      </view>
      <view class="venue-actions">
        <text class="action-link" bindtap="onSlotManage" data-id="{{item.id}}">时段</text>
        <text class="action-link" bindtap="onShowModal" data-mode="edit" data-venue="{{item}}">编辑</text>
        <text class="action-link danger" bindtap="onDelete" data-venue="{{item}}">删除</text>
      </view>
    </view>
  </view>

  <!-- Empty State -->
  <view class="empty-state" wx:if="{{venues.length === 0 && !loading}}">
    <text>暂无场地</text>
  </view>

  <!-- Loading -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- Add Button -->
  <view class="fab-btn" bindtap="onShowModal" data-mode="create">
    <text class="fab-icon">+</text>
  </view>

  <!-- Create/Edit Modal -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="onCloseModal">
    <view class="modal-content" catchtap="onPanelTap">
      <view class="modal-header">
        <text class="modal-title">{{modalMode === 'create' ? '添加场地' : '编辑场地'}}</text>
        <text class="modal-close" bindtap="onCloseModal">✕</text>
      </view>

      <view class="form-group">
        <text class="form-label">场地名称 *</text>
        <input class="form-input" placeholder="请输入场地名称" value="{{form.name}}"
          data-field="name" bindinput="onInputChange" />
      </view>

      <view class="form-group">
        <text class="form-label">运动类型</text>
        <view class="form-picker" style="color:#999">网球</view>
      </view>

      <view class="form-group">
        <text class="form-label">每小时价格 *</text>
        <input class="form-input" type="digit" placeholder="0.00" value="{{form.price_per_hour}}"
          data-field="price_per_hour" bindinput="onInputChange" />
      </view>

      <view class="form-group">
        <text class="form-label">容纳人数</text>
        <input class="form-input" type="number" placeholder="4" value="{{form.max_capacity}}"
          data-field="max_capacity" bindinput="onInputChange" />
      </view>

      <view class="form-group">
        <text class="form-label">排序</text>
        <input class="form-input" type="number" placeholder="0" value="{{form.sort_order}}"
          data-field="sort_order" bindinput="onInputChange" />
      </view>

      <view class="form-group" wx:if="{{modalMode === 'edit'}}">
        <text class="form-label">状态</text>
        <picker bindchange="onInputChange" data-field="status" value="{{form.status === 'active' ? 0 : form.status === 'maintenance' ? 1 : 2}}" range="{{['正常','维护中','已关闭']}}">
          <view class="form-picker">{{form.status === 'active' ? '正常' : form.status === 'maintenance' ? '维护中' : '已关闭'}}</view>
        </picker>
      </view>

      <button class="btn-submit" bindtap="onSubmit">保存</button>
    </view>
  </view>
</view>
