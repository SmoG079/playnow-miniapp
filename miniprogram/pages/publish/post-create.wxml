<view class="page">
  <view class="card">
    <text class="form-label">标题 *</text>
    <input class="form-input" placeholder="如：周末网球3缺1" value="{{title}}" bindinput="onField" data-field="title" />

    <!-- Mode Toggle -->
    <text class="form-label">约球模式</text>
    <view class="mode-toggle">
      <view class="mode-btn {{matchMode === 'free' ? 'active' : ''}}" data-mode="free" bindtap="onModeSwitch">🏸 自由约球</view>
      <view class="mode-btn {{matchMode === 'venue' ? 'active' : ''}}" data-mode="venue" bindtap="onModeSwitch">🏟️ 定场约球</view>
    </view>

    <!-- 定场约球：俱乐部 + 场地预约 -->
    <block wx:if="{{matchMode === 'venue'}}">
      <text class="form-label">俱乐部 *</text>
      <picker mode="selector" range="{{clubNames}}" value="{{clubIndex}}" bindchange="onClubChange">
        <view class="form-picker">
          <text class="{{clubIndex > -1 ? '' : 'text-light'}}">{{clubIndex > -1 ? clubNames[clubIndex] : '选择俱乐部'}}</text>
          <text>›</text>
        </view>
      </picker>

      <block wx:if="{{linkedBookingId}}">
        <view class="linked-booking">
          <text class="linked-label">🏟️ 已关联场地</text>
          <text>{{linkedVenueName}} · {{linkedSlot}}</text>
          <text class="linked-clear" bindtap="onClearBooking">取消关联</text>
        </view>
      </block>
      <button wx:else class="btn-book-venue" bindtap="onGoBookVenue" disabled="{{clubIndex === -1}}">🏟️ 去订场并关联此约球</button>
    </block>

    <text class="form-label">还差几人 *</text>
    <input class="form-input" type="number" placeholder="如：1" value="{{playersNeeded}}" bindinput="onField" data-field="playersNeeded" />

    <text class="form-label">人均费用（元）*</text>
    <input class="form-input" type="digit" placeholder="如：50，填 0 表示免费" value="{{price}}" bindinput="onPriceChange" />

    <text class="form-label">NTRP 等级</text>
    <view class="level-section">
      <view class="level-display">{{levelMin === 0 && levelMax === 0 ? '不限' : (levelOptions[levelMin] === levelOptions[levelMax] ? levelOptions[levelMin] : levelOptions[levelMin] + '-' + levelOptions[levelMax])}}</view>
      <view class="slider-row">
        <text class="slider-label">最低</text>
        <slider class="level-slider" min="0" max="13" step="1" value="{{levelMin}}" block-size="18" activeColor="#5CD29D" bindchange="onLevelMinChange" />
        <text class="slider-value">{{levelOptions[levelMin]}}</text>
      </view>
      <view class="slider-row">
        <text class="slider-label">最高</text>
        <slider class="level-slider" min="0" max="13" step="1" value="{{levelMax}}" block-size="18" activeColor="#5CD29D" bindchange="onLevelMaxChange" />
        <text class="slider-value">{{levelOptions[levelMax]}}</text>
      </view>
      <view class="level-scale">
        <text wx:for="{{levelOptions}}" wx:key="*this" wx:if="{{index > 0}}" class="scale-item">{{item}}</text>
      </view>
    </view>

    <view class="form-row form-row-between">
      <text class="form-label">报名需要审核</text>
      <switch checked="{{approvalRequired}}" bindchange="onApprovalChange" />
    </view>

    <text class="form-label">详情说明</text>
    <textarea class="form-textarea" placeholder="详细介绍活动规则、注意事项、联系方式等..." value="{{description}}" bindinput="onField" data-field="description" />

    <text class="form-label">备注</text>
    <textarea class="form-textarea" placeholder="补充说明（会显示在标题下方标签）..." value="{{notes}}" bindinput="onField" data-field="notes" />

    <text class="form-label">活动图片（最多6张，可选）</text>
    <view class="img-grid">
      <view class="img-item" wx:for="{{images}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}" />
        <view class="img-remove" data-idx="{{index}}" bindtap="removeImage">×</view>
      </view>
      <view class="img-add" bindtap="chooseImage" wx:if="{{images.length < 6}}">
        <text class="add-icon">+</text>
        <text class="add-text">添加图片</text>
      </view>
    </view>

    <text class="form-label">附件（PDF）</text>
    <view class="document-list">
      <view class="doc-item" wx:for="{{documents}}" wx:key="url">
        <text class="doc-icon">📄</text>
        <text class="doc-name">{{item.name}}</text>
        <text class="doc-remove" data-index="{{index}}" bindtap="onRemoveDocument">✕</text>
      </view>
      <view class="doc-add" bindtap="onAddDocument">
        <text class="doc-add-icon">+</text>
        <text class="doc-add-text">添加 PDF 文件</text>
      </view>
    </view>
  </view>

  <view class="submit-area">
    <button class="btn-primary" bindtap="onSubmit" loading="{{loading}}" disabled="{{!title || clubIndex === -1}}">发布约球帖</button>
    <text class="form-tip">* 号为必填项</text>
  </view>
</view>
