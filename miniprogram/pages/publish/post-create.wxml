<view class="page">
  <view class="card">
    <text class="form-label">标题 *</text>
    <input class="form-input" placeholder="如：周末网球3缺1" value="{{title}}" bindinput="onField" data-field="title" />

    <text class="form-label">俱乐部 *</text>
    <picker mode="selector" range="{{clubNames}}" value="{{clubIndex}}" bindchange="onClubChange">
      <view class="form-picker">
        <text class="{{clubIndex > -1 ? '' : 'text-light'}}">{{clubIndex > -1 ? clubNames[clubIndex] : '选择俱乐部'}}</text>
        <text>›</text>
      </view>
    </picker>

    <!-- Mode Switch -->
    <text class="form-label">约球模式</text>
    <view class="mode-switch">
      <view class="mode-item {{mode === 0 ? 'active' : ''}}" data-mode="0" bindtap="onModeSwitch">🏸 自由约球</view>
      <view class="mode-item {{mode === 1 ? 'active' : ''}}" data-mode="1" bindtap="onModeSwitch">🏟️ 订场约球</view>
    </view>

    <!-- 订场约球: slot selection -->
    <block wx:if="{{mode === 1}}">
      <text class="form-label">选择场地</text>
      <picker mode="selector" range="{{venueNames}}" value="{{venueIndex}}" bindchange="onVenueChange">
        <view class="form-picker">
          <text class="{{venueIndex > -1 ? '' : 'text-light'}}">{{venueIndex > -1 ? venueNames[venueIndex] : '请选择'}}</text>
          <text>›</text>
        </view>
      </picker>

      <block wx:if="{{venueIndex > -1}}">
        <!-- Date tabs -->
        <scroll-view class="date-scroll" scroll-x style="margin-top:16rpx">
          <view wx:for="{{dates}}" wx:key="value"
            class="date-tab {{selectedDate === item.value ? 'active' : ''}}"
            data-date="{{item.value}}" bindtap="onDateSelect">{{item.label}}</view>
        </scroll-view>

        <!-- Slot grid -->
        <view class="slot-grid" wx:if="{{!slotLoading}}">
          <view wx:for="{{venueSlots}}" wx:key="id"
            class="slot-item {{item.status}} {{item._sel ? 'selected' : ''}}"
            data-slot="{{item}}" bindtap="onSlotTap">
            <text class="slot-time">{{item.start_time}}-{{item.end_time}}</text>
            <text class="slot-price">¥{{item.price}}</text>
            <text class="slot-tag" wx:if="{{item.status === 'booked'}}">已约</text>
            <text class="slot-tag" wx:elif="{{item.status === 'locked'}}">锁定</text>
            <text class="slot-tick" wx:elif="{{item._sel}}">✓</text>
          </view>
        </view>
        <text wx:if="{{slotLoading}}" class="text-sm text-secondary">加载中...</text>
        <text wx:if="{{!slotLoading && venueSlots.length === 0}}" class="text-sm text-secondary">暂无可用时段</text>

        <!-- Selected slot info -->
        <view class="slot-selected" wx:if="{{selectedSlotInfo}}">
          <text class="text-primary">已选：{{selectedSlotInfo.date}} {{selectedSlotInfo.startTime}}-{{selectedSlotInfo.endTime}} · ¥{{selectedSlotInfo.price}}</text>
        </view>
        <text class="form-hint">选择连续两格=1小时，发布时自动锁定场地</text>
      </block>
    </block>

    <text class="form-label">还差几人</text>
    <input class="form-input" type="number" placeholder="如：1" value="{{playersNeeded}}" bindinput="onField" data-field="playersNeeded" />

    <text class="form-label">水平要求</text>
    <picker mode="selector" range="{{levels}}" value="{{levelIndex}}" bindchange="onLevelChange">
      <view class="form-picker">
        <text class="{{levelIndex > -1 ? '' : 'text-light'}}">{{levelIndex > -1 ? levels[levelIndex] : '不限'}}</text>
        <text>›</text>
      </view>
    </picker>

    <text class="form-label">备注</text>
    <textarea class="form-textarea" placeholder="补充说明..." value="{{notes}}" bindinput="onField" data-field="notes" />
  </view>

  <view class="submit-area">
    <button class="btn-primary" bindtap="onSubmit" loading="{{loading}}" disabled="{{!title || clubIndex === -1 || (mode === 1 && !selectedSlotInfo)}}">发布约球帖</button>
  </view>
</view>
