.page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-top: 24rpx;
  margin-bottom: 12rpx;
}

.form-label:first-child {
  margin-top: 0;
}

.form-input,
.form-textarea,
.form-picker {
  background-color: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  height: 160rpx;
  width: auto;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-picker .icon {
  font-size: 24rpx;
  color: #999;
}

.text-light {
  color: #999;
}

.submit-area {
  margin: 40rpx 20rpx;
}

.btn-primary {
  background-color: #4CD964;
  color: #fff;
  border-radius: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary[disabled] {
  background-color: #b2dfbb;
  color: #fff;
}
