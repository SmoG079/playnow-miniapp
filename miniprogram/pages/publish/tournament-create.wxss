.page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-top: 24rpx;
  margin-bottom: 12rpx;
}

.form-label:first-child {
  margin-top: 0;
}

.form-input,
.form-textarea,
.form-picker {
  background-color: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  height: 160rpx;
  width: auto;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-picker .icon {
  font-size: 24rpx;
  color: #999;
}

.text-light {
  color: #999;
}

.submit-area {
  margin: 40rpx 20rpx;
}

.btn-primary {
  background-color: #4CD964;
  color: #fff;
  border-radius: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary[disabled] {
  background-color: #b2dfbb;
  color: #fff;
}

.linked-booking { background: #e8f5e9; border-radius: 8rpx; padding: 16rpx; margin: 16rpx 0; display: flex; flex-direction: column; gap: 6rpx; }
.linked-label { font-size: 26rpx; font-weight: 600; color: #2e7d32; }
.linked-clear { font-size: 24rpx; color: #f44336; }
.btn-book-venue { width: 100%; height: 80rpx; line-height: 80rpx; background: #e8f5e9; color: #2e7d32; border: 2rpx dashed #4caf50; border-radius: 12rpx; font-size: 28rpx; margin: 16rpx 0; }

/* Image grid */
.img-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 12rpx 0; }
.img-item { width: 150rpx; height: 150rpx; position: relative; border-radius: 8rpx; overflow: hidden; }
.img-item image { width: 100%; height: 100%; }
.img-remove { position: absolute; top: 0; right: 0; width: 40rpx; height: 40rpx; background: rgba(0,0,0,0.5); color: #fff; font-size: 28rpx; display: flex; align-items: center; justify-content: center; border-radius: 0 8rpx 0 8rpx; }
.img-add { width: 150rpx; height: 150rpx; background: #f5f5f5; border-radius: 8rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed #ddd; }
.img-add .add-icon { font-size: 48rpx; color: #999; }
.img-add .add-text { font-size: 22rpx; color: #999; margin-top: 4rpx; }
