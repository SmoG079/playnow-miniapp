<view class="page">
  <!-- Club Selector -->
  <view class="club-picker" wx:if="{{managedClubs.length > 1}}">
    <picker bindchange="onClubChange" value="{{selectedClubIndex}}" range="{{managedClubs}}">
      <view class="picker-value">
        <text>俱乐部: {{managedClubs[selectedClubIndex]}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- Stats Cards -->
  <view class="stats-grid" wx:if="{{stats}}">
    <view class="stat-card">
      <text class="stat-num">{{stats.total_venues}}</text>
      <text class="stat-label">场地数</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.total_orders}}</text>
      <text class="stat-label">总订单</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">¥{{stats.total_revenue}}</text>
      <text class="stat-label">总收入</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.today_orders}}</text>
      <text class="stat-label">今日订单</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">¥{{stats.today_revenue}}</text>
      <text class="stat-label">今日收入</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.venue_utilization_str}}</text>
      <text class="stat-label">场地利用率</text>
    </view>
  </view>

  <!-- Loading -->
  <view class="loading-state" wx:if="{{loading && !stats}}">
    <text>加载中...</text>
  </view>

  <!-- Empty -->
  <view class="empty-state" wx:if="{{managedClubs.length === 0 && !loading}}">
    <text>您没有管理的俱乐部</text>
  </view>

  <!-- Menu Grid -->
  <view class="menu-grid" wx:if="{{managedClubs.length > 0}}">
    <view class="menu-item" data-page="/pages/admin/club-manage" bindtap="onMenuTap">
      <text class="menu-icon">🏠</text>
      <text class="menu-title">俱乐部管理</text>
    </view>
    <view class="menu-item" data-page="/pages/admin/venue-manage" bindtap="onMenuTap">
      <text class="menu-icon">🏟️</text>
      <text class="menu-title">场地管理</text>
    </view>
    <view class="menu-item" data-page="/pages/admin/order-manage" bindtap="onMenuTap">
      <text class="menu-icon">📋</text>
      <text class="menu-title">订单管理</text>
    </view>
  </view>
</view>
