<view class="page">
  <view class="action-bar">
    <view class="btn-primary" bindtap="onCreate">创建俱乐部</view>
  </view>

  <view class="club-list" wx:if="{{clubs.length > 0}}">
    <view class="club-card" wx:for="{{clubs}}" wx:key="id" data-id="{{item.id}}" bindtap="onEdit">
      <image class="club-cover" src="{{item.cover_image || '/images/default-venue.png'}}" mode="aspectFill" />
      <view class="club-info">
        <text class="club-name">{{item.name}}</text>
        <text class="club-address" wx:if="{{item.address}}">{{item.address}}</text>
        <text class="club-status {{item.status}}">{{item.status === 'active' ? '营业中' : '休息中'}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="empty-state" wx:if="{{clubs.length === 0 && !loading}}">
    <text>暂无俱乐部</text>
  </view>

  <view class="loading-state" wx:if="{{loading && clubs.length === 0}}">
    <text>加载中...</text>
  </view>
</view>
