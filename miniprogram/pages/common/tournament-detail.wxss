.page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.loading-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #999;
  font-size: 30rpx;
}

/* Cover Header */
.cover-wrap {
  position: relative;
  height: 400rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.1) 50%, rgba(0,0,0,0.6) 100%);
}

.nav-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  background-color: rgba(0,0,0,0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon {
  color: #fff;
  font-size: 36rpx;
}

.cover-content {
  position: absolute;
  bottom: 40rpx;
  left: 30rpx;
  right: 30rpx;
}

.sport-badge {
  display: inline-block;
  background-color: #4CD964;
  color: #fff;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.tournament-title {
  display: block;
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.tournament-club {
  color: rgba(255,255,255,0.9);
  font-size: 28rpx;
}

/* Info Card */
.info-card,
.section-card {
  background-color: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.info-value.amount {
  color: #ff6b6b;
  font-weight: 600;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.section-body {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.placeholder {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* Bottom Bar */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  line-height: 1.2;
  margin: 0;
  padding: 0 30rpx;
}

.share-btn::after {
  border: none;
}

.share-icon {
  font-size: 36rpx;
  color: #666;
}

.share-text {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
}

.action-btn {
  flex: 1;
  margin-left: 30rpx;
  background-color: #4CD964;
  color: #fff;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.action-btn.pay {
  background-color: #ff9800;
}

.action-btn.disabled {
  background-color: #ccc;
  color: #fff;
}
