.login-page {
  min-height: 100vh;
  display: flex; flex-direction: column;
  align-items: center; justify-content: space-between;
  padding: 120rpx 60rpx 80rpx;
  background: linear-gradient(180deg, #e8f8ee 0%, #fff 60%);
}
.login-header { text-align: center; }
.logo { width: 160rpx; height: 160rpx; }
.app-name { display: block; font-size: 40rpx; font-weight: 700; margin-top: 24rpx; }
.app-desc { display: block; color: var(--text-secondary); font-size: 26rpx; margin-top: 8rpx; }

.login-body { width: 100%; display: flex; flex-direction: column; align-items: center; gap: 30rpx; }
.avatar-wrapper { width: 120rpx; height: 120rpx; border-radius: 50%; overflow: hidden; padding: 0; line-height: 0; }
.avatar { width: 100%; height: 100%; }
.avatar-tip { display: block; font-size: 22rpx; color: var(--text-light); margin-top: 8rpx; }

.nickname-input { width: 80%; }
.nickname-input .input {
  background: #fff; border-radius: 12rpx; padding: 20rpx 30rpx;
  border: 1rpx solid var(--border); text-align: center;
}

.phone-btn {
  width: 80%; background: #fff; border: 1rpx solid var(--border);
  border-radius: 12rpx; padding: 20rpx; font-size: 28rpx;
}

.login-footer { width: 100%; }
.agreement { display: flex; align-items: center; gap: 8rpx; margin-bottom: 30rpx; font-size: 22rpx; color: var(--text-secondary); }
.agreement .link { color: var(--primary); }

.login-btn {
  width: 100%; border-radius: 44rpx; padding: 24rpx;
  background: #c0c0c0; color: #fff; font-size: 32rpx;
}
.login-btn.active { background: var(--primary); }
