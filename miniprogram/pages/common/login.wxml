<view class="login-page">
  <view class="login-header">
    <image class="logo" src="/images/default-venue.png" mode="aspectFit" />
    <text class="app-name">运动俱乐部</text>
    <text class="app-desc">约球 · 订场 · 比赛</text>
  </view>

  <view class="login-body">
    <!-- Avatar Picker -->
    <button class="avatar-wrapper" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar" src="{{avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
      <text class="avatar-tip">点击设置头像</text>
    </button>

    <!-- Nickname Input -->
    <view class="nickname-input">
      <input
        class="input"
        type="nickname"
        placeholder="请输入昵称"
        value="{{nickname}}"
        bindinput="onNicknameInput"
      />
    </view>

    <!-- Phone Number -->
    <button class="phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
      <text>📱 授权手机号</text>
    </button>
  </view>

  <view class="login-footer">
    <view class="agreement">
      <checkbox checked="{{agreed}}" bindtap="onAgreementChange" />
      <text>已阅读并同意 <text class="link">《用户协议》</text> 和 <text class="link">《隐私政策》</text></text>
    </view>

    <button
      class="login-btn {{agreed ? 'active' : ''}}"
      bindtap="onLogin"
      loading="{{loading}}"
      disabled="{{!agreed}}"
    >
      微信一键登录
    </button>
  </view>
</view>
