<view class="page">
  <!-- Loading -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- Content -->
  <block wx:if="{{!loading && post}}">
    <!-- 顶部图片 -->
    <view class="cover-image-wrapper">
      <image class="cover-image" src="{{post.cover_image || '/images/default-venue.jpg'}}" mode="aspectFill" />
      <view class="cover-gradient"></view>
      <view class="nav-bar">
        <view class="nav-back" bindtap="onBack">
          <text class="nav-icon">←</text>
        </view>
        <view class="nav-more" bindtap="onMore">
          <text class="nav-icon">•••</text>
        </view>
      </view>
    </view>

    <!-- 标题区 -->
    <view class="header-section">
      <view class="badge-row" wx:if="{{post.sport_type}}">
        <view class="sport-badge">{{post.sport_type}}</view>
      </view>
      <text class="post-title">{{post.title}}</text>
      <view class="tags-row" wx:if="{{post.notes}}">
        <text class="tag-text">{{post.notes}}</text>
      </view>
    </view>

    <!-- 信息列表 -->
    <view class="info-section">
      <view class="info-item" bindtap="onCallPhone">
        <text class="info-label">发起人</text>
        <view class="info-content">
          <text class="info-value">{{post.user_nickname || ('用户' + post.user_id)}}</text>
          <text class="phone-icon">📞</text>
        </view>
      </view>

      <view class="info-item">
        <text class="info-label">时间</text>
        <text class="info-value">{{post.preferred_date}} {{post.weekday}} {{post.preferred_start}} - {{post.preferred_end}}</text>
      </view>

      <view class="info-item" bindtap="onOpenMap">
        <text class="info-label">地点</text>
        <view class="info-content">
          <view class="location-wrapper">
            <text class="info-value location-name">{{post.club_name}}</text>
            <text class="info-subvalue" wx:if="{{post.venue_address}}">{{post.venue_address}}</text>
          </view>
          <text class="arrow-icon">›</text>
        </view>
      </view>
    </view>

    <!-- 价格 & 报名状态 -->
    <view class="price-section" wx:if="{{post.price !== null && post.price !== undefined}}">
      <view class="price-left">
        <text class="price-symbol">¥</text>
        <text class="price-value">{{post.price}}</text>
      </view>
      <view class="price-right" bindtap="onShowRegistrations">
        <text class="registration-status {{isFull ? 'full' : ''}}">
          已报名 {{post.registration_count}}/{{post.players_needed}}
        </text>
        <text wx:if="{{post.approval_required && post.pending_count > 0}}" class="pending-badge">待审核 {{post.pending_count}}</text>
        <text class="arrow-icon">›</text>
      </view>
    </view>

    <!-- 描述 -->
    <view class="description-section" wx:if="{{post.description || post.notes}}">
      <text class="section-title">详情说明</text>
      <text class="description-text" wx:if="{{post.description}}">{{post.description}}</text>
      <text class="notes-text" wx:if="{{post.notes}}">备注：{{post.notes}}</text>
    </view>

    <!-- 附件/PDF -->
    <view class="documents-section" wx:if="{{post.documents && post.documents.length > 0}}">
      <text class="section-title">附件</text>
      <view class="document-list">
        <view class="doc-item" wx:for="{{post.documents}}" wx:key="url" bindtap="onOpenDocument" data-url="{{item.url}}" data-name="{{item.name}}">
          <text class="doc-icon">📄</text>
          <text class="doc-name">{{item.name}}</text>
          <text class="arrow-icon">›</text>
        </view>
      </view>
    </view>

    <!-- 场地规则/PDF -->
    <view class="documents-section" wx:if="{{post.club_documents && post.club_documents.length > 0}}">
      <text class="section-title">场地规则</text>
      <view class="document-list">
        <view class="doc-item" wx:for="{{post.club_documents}}" wx:key="url" bindtap="onOpenDocument" data-url="{{item.url}}" data-name="{{item.name}}">
          <text class="doc-icon">📄</text>
          <text class="doc-name">{{item.name}}</text>
          <text class="arrow-icon">›</text>
        </view>
      </view>
    </view>

    <!-- 已报名用户 -->
    <view class="registrations-section" wx:if="{{registrations.length > 0}}">
      <view class="section-header" bindtap="onShowRegistrations">
        <text class="section-title">已报名用户</text>
        <text class="arrow-icon">›</text>
      </view>
      <view class="avatar-list">
        <view class="avatar-item" wx:for="{{registrations}}" wx:key="id" wx:if="{{index < 6}}">
          <image class="avatar-image" src="{{item.user_avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
          <text class="avatar-name">{{item.user_nickname}}</text>
        </view>
        <view class="avatar-item" wx:if="{{registrations.length > 6}}">
          <view class="avatar-more">
            <text class="avatar-more-text">...</text>
          </view>
        </view>
      </view>
    </view>
    <!-- 评论区域 -->
    <view class="comments-section">
      <view class="section-header">
        <text class="section-title">评论</text>
        <text class="comment-count" wx:if="{{comments.length > 0}}">{{comments.length}}条</text>
      </view>

      <view class="comment-list" wx:if="{{comments.length > 0}}">
        <view class="comment-item" wx:for="{{comments}}" wx:key="id" data-id="{{item.id}}" data-userid="{{item.user_id}}" bindlongpress="onCommentLongPress">
          <image class="comment-avatar" src="{{item.user_avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
          <view class="comment-body">
            <view class="comment-meta">
              <text class="comment-name">{{item.user_nickname}}</text>
              <text class="comment-time">{{item.created_at}}</text>
            </view>
            <text class="comment-content {{item.is_deleted ? 'deleted' : ''}}">{{item.content}}</text>
            <view class="comment-actions" wx:if="{{!item.is_deleted}}">
              <text class="comment-action" data-id="{{item.id}}" data-nickname="{{item.user_nickname}}" bindtap="onReplyTap">回复</text>
            </view>

            <view class="replies" wx:if="{{item.replies && item.replies.length > 0}}">
              <view class="reply-item" wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id">
                <text class="reply-name">{{reply.user_nickname}}</text>
                <text class="reply-content {{reply.is_deleted ? 'deleted' : ''}}">{{reply.content}}</text>
              </view>
              <text wx:if="{{item.reply_count > item.replies.length}}" class="reply-more">展开更多回复</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{comments.length === 0 && !commentLoading}}" class="comment-empty">
        <text>暂无评论，来说两句吧</text>
      </view>

      <!-- 评论输入栏 -->
      <view class="comment-input-bar">
        <view wx:if="{{replyTo}}" class="reply-tip">
          <text>回复 {{replyTo.nickname}}</text>
          <text class="cancel-reply" bindtap="onCancelReply">取消</text>
        </view>
        <view class="input-row">
          <input
            class="comment-input"
            placeholder="{{replyTo ? '回复评论...' : '说点什么...'}}"
            value="{{commentInput}}"
            bindinput="onCommentInput"
            confirm-type="send"
            bindconfirm="onSubmitComment"
          />
          <button class="comment-send" bindtap="onSubmitComment">发送</button>
        </view>
      </view>
    </view>
  </block>

  <!-- 报名用户弹窗 -->
  <view class="reg-popup {{showRegPopup ? 'show' : ''}}" bindtap="onCloseRegPopup" wx:if="{{showRegPopup}}">
    <view class="reg-overlay"></view>
    <view class="reg-panel" catchtap="onRegPanelTap">
      <view class="reg-panel-header">
        <text class="reg-panel-title">已报名用户</text>
        <text class="reg-panel-close" bindtap="onCloseRegPopup">✕</text>
      </view>
      <view class="reg-list">
        <view class="reg-item" wx:for="{{registrations}}" wx:key="id">
          <image class="reg-avatar" src="{{item.user_avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
          <view class="reg-info">
            <text class="reg-name">{{item.user_nickname}}</text>
            <text class="reg-status {{item.status}}">{{item.status === 'approved' ? '已通过' : item.status === 'rejected' ? '已拒绝' : '待审核'}}</text>
          </view>
          <text wx:if="{{item.message}}" class="reg-message">{{item.message}}</text>
        </view>
        <view wx:if="{{registrations.length === 0}}" class="reg-empty">
          <text>暂无报名用户</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar" wx:if="{{!loading && post}}">
    <view class="bottom-left">
      <view class="bottom-btn" bindtap="onOpenChat">
        <text class="bottom-icon">💬</text>
        <text class="bottom-text">群聊</text>
      </view>
      <button class="bottom-btn share-btn" open-type="share">
        <text class="bottom-icon">↗</text>
        <text class="bottom-text">分享</text>
      </button>
    </view>
    <view class="bottom-right">
      <view
        class="action-btn {{isOwner ? '' : (isRegistered ? 'registered' : '')}} {{!isOwner && isFull && !isRegistered ? 'disabled' : ''}}"
        bindtap="onRegister"
      >
        <text wx:if="{{isOwner}}">审核报名</text>
        <text wx:elif="{{isRegistered && myRegistrationStatus === 'pending'}}">审核中</text>
        <text wx:elif="{{isRegistered}}">已报名</text>
        <text wx:elif="{{isFull}}">已满员</text>
        <text wx:elif="{{post.price !== null && post.price !== undefined && post.price !== ''}}">报名 ¥{{post.price}}</text>
        <text wx:else>报名</text>
      </view>
    </view>
  </view>

</view>
