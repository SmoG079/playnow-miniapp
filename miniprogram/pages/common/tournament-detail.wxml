<view class="page">
  <!-- Loading -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <block wx:if="{{!loading && tournament}}">
    <!-- Cover Header -->
    <view class="cover-wrap">
      <image class="cover-image" src="{{tournament.cover_image || '/images/default-venue.jpg'}}" mode="aspectFill" />
      <view class="cover-gradient"></view>
      <view class="nav-bar">
        <view class="nav-back" bindtap="onBack">
          <text class="nav-icon">←</text>
        </view>
      </view>
      <view class="cover-content">
        <view class="sport-badge" wx:if="{{tournament.sport_type}}">{{tournament.sport_type}}</view>
        <text class="tournament-title">{{tournament.title}}</text>
        <text class="tournament-club">🏠 {{tournament.club_name}}</text>
      </view>
    </view>

    <!-- Info Section -->
    <view class="info-card">
      <view class="info-row">
        <text class="info-label">开始时间</text>
        <text class="info-value">{{tournament.start_time}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">结束时间</text>
        <text class="info-value">{{tournament.end_time}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">报名费用</text>
        <text class="info-value amount">¥{{tournament.entry_fee || '0.00'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">报名人数</text>
        <text class="info-value">{{tournament.current_participants || 0}}/{{tournament.max_participants || '不限'}}</text>
      </view>
      <view class="info-row" wx:if="{{tournament.prize}}">
        <text class="info-label">奖品</text>
        <text class="info-value">{{tournament.prize}}</text>
      </view>
    </view>

    <!-- Description -->
    <view class="section-card" wx:if="{{tournament.description}}">
      <text class="section-title">赛事介绍</text>
      <text class="section-body">{{tournament.description}}</text>
    </view>

    <!-- Bracket Placeholder -->
    <view class="section-card">
      <text class="section-title">赛程安排</text>
      <view class="placeholder">
        <text>赛程将在报名截止后生成</text>
      </view>
    </view>
  </block>

  <!-- Bottom Action Bar -->
  <view class="bottom-bar" wx:if="{{!loading && tournament}}">
    <button class="share-btn" open-type="share">
      <text class="share-icon">↗</text>
      <text class="share-text">分享</text>
    </button>
    <view
      class="action-btn {{btnClass}}"
      bindtap="onRegister"
    >
      <text>{{btnText}}</text>
    </view>
  </view>
</view>
