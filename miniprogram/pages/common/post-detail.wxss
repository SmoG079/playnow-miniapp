.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 160rpx;
}

/* Loading */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

/* Cover Image */
.cover-image-wrapper {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-gradient {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 150rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.3), transparent);
}

.nav-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 30rpx;
  z-index: 10;
}

.nav-back, .nav-more {
  width: 64rpx;
  height: 64rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon {
  color: #fff;
  font-size: 32rpx;
}

/* Header Section */
.header-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.badge-row {
  margin-bottom: 16rpx;
}

.sport-badge {
  display: inline-block;
  background: #e3f2fd;
  color: #1976d2;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.post-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-text {
  font-size: 24rpx;
  color: #999;
}

/* Info Section */
.info-section {
  background: #fff;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}

.info-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

.info-subvalue {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.phone-icon {
  font-size: 32rpx;
  margin-left: 16rpx;
}

.location-wrapper {
  flex: 1;
}

.location-name {
  display: block;
}

.arrow-icon {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 16rpx;
}

/* Price Section */
.price-section {
  background: #fff;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.price-left {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 28rpx;
  color: #ff9500;
  font-weight: bold;
}

.price-value {
  font-size: 48rpx;
  color: #ff9500;
  font-weight: bold;
}

.price-right {
  display: flex;
  align-items: center;
}

.registration-status {
  font-size: 28rpx;
  color: #07c160;
}

.registration-status.full {
  color: #ff5252;
}

/* Documents Section */
.documents-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.document-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.doc-item {
  display: flex;
  align-items: center;
  background: #f8f8f8;
  padding: 20rpx;
  border-radius: 8rpx;
}

.doc-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.doc-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Registrations Section */
.registrations-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.description-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.description-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
}

.notes-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
  display: block;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

/* Registrations popup */
.reg-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.2s;
}

.reg-popup.show {
  pointer-events: auto;
  opacity: 1;
}

.reg-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.reg-panel {
  position: relative;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.2s;
}

.reg-popup.show .reg-panel {
  transform: translateY(0);
}

.reg-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.reg-panel-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.reg-panel-close {
  font-size: 36rpx;
  color: #999;
  padding: 0 10rpx;
}

.reg-list {
  padding: 20rpx 30rpx;
  overflow-y: auto;
  max-height: 60vh;
}

.reg-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.reg-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-right: 20rpx;
}

.reg-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.reg-name {
  font-size: 28rpx;
  color: #333;
}

.reg-status {
  font-size: 24rpx;
  color: #ff9500;
  margin-top: 4rpx;
}

.reg-status.approved {
  color: #07c160;
}

.reg-status.rejected {
  color: #ff5252;
}

.reg-message {
  width: 100%;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  word-break: break-word;
}

.reg-empty {
  padding: 60rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.avatar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
}

.avatar-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.avatar-name {
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
  text-align: center;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.avatar-more {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-more-text {
  font-size: 32rpx;
  color: #999;
}

/* Bottom Bar */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.bottom-left {
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin-right: 30rpx;
}

.bottom-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: none;
  border: none;
  padding: 0;
  line-height: 1;
}

.bottom-btn::after {
  border: none;
}

.share-btn {
  margin: 0;
  background: transparent;
}

.bottom-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.bottom-text {
  font-size: 22rpx;
  color: #666;
}

.bottom-right {
  flex: 1;
}

.action-btn {
  height: 80rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.registered {
  background: #e0e0e0;
  color: #666;
}

.action-btn.disabled {
  background: #ccc;
  color: #fff;
}

.pending-badge {
  background: #ff9800;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-left: 12rpx;
}

/* Comments Section */
.comments-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.comments-section .section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.comments-section .section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.comment-count {
  font-size: 24rpx;
  color: #999;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.comment-item {
  display: flex;
  gap: 16rpx;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
}

.comment-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.comment-name {
  font-size: 28rpx;
  color: #666;
}

.comment-time {
  font-size: 24rpx;
  color: #999;
}

.comment-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-all;
}

.comment-content.deleted {
  color: #999;
  font-style: italic;
}

.comment-actions {
  margin-top: 10rpx;
}

.comment-action {
  font-size: 26rpx;
  color: #1976d2;
}

.replies {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
}

.reply-item {
  margin-bottom: 12rpx;
}

.reply-item:last-child {
  margin-bottom: 0;
}

.reply-name {
  font-size: 26rpx;
  color: #666;
  margin-right: 12rpx;
}

.reply-content {
  font-size: 28rpx;
  color: #333;
}

.reply-content.deleted {
  color: #999;
  font-style: italic;
}

.reply-more {
  font-size: 26rpx;
  color: #1976d2;
}

.comment-empty {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* Comment Input Bar */
.comment-input-bar {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
  background: #fff;
}

.reply-tip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.cancel-reply {
  color: #1976d2;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.comment-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

.comment-send {
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  line-height: 1;
  border: none;
}

.comment-send::after {
  border: none;
}
